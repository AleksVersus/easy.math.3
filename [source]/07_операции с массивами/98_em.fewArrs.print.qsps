QSP-Game распечатка содержимого нескольких массивов. Удобно для вывода данных

!@ %0 - имена массивов, содержимое которых необходимо распечатать.
!@ $1 - управляющая конструкция.
!@ $2 - колбэк формата
!@pp:if(em_fewarrs_print):include
# em.fewArrs.print
args[21] = len(%args[0])	& !@ получаем число массивов к выводу
$args[23] = 'Error: All your massives are empty.' & !@ текст, если все массивы пустые
args[25], args[26] = 0, -1
args[27], args[28] = 1, 0
result = ''
!@ ======================================= P R E P A R E ===========================================

if $args[1]:
	$args[30] = $lcase($args[1])	& !@ переводим в нижний регистр
	!@ по управляющей конструкции понимаем, нужно строить таблицу или нет
	args[27] = iif(instr($args[30],'[no table]'), 0, 1)
	!@ по управляющей конструкции понимаем, нужно ли выводить одни только результаты
	if instr($args[30],'[only result]'): args[27], args[28] = 0, 1
	!@ получаем номера первого и последнего элементов, которые хотим вывести
	if instr($args[30], '[range onscreen:'):
		args[25] = val($strfind($args[30], '\[range onscreen:(\d+)\-\d+\]', 1))
		!@ вместо последнего элемента нам нужен следующий за последним
		args[26] = val($strfind($args[30], '\[range onscreen:\d+\-(\d+)\]', 1)) + 1
	end
	if instr($args[1], '[empty:'):
		$args[23] = $strfind($args[1], '(?i)\[empty:(.*?)\]', 1)
	end
end
!@ %37 - валидные имена массивов
!@ $38 - текущее имя массива
%args[22], args[29] = [], 0
loop args[31] = 0 while args[31]<args[21] step args[31] += 1:
	$args[24], %args[0] = %args[0]
	if strcomp($args[24], '[#%$]?[\p{L}_\.][\p{L}_\.0-9]*'):
		!@ valid array name
		%args[22] = (%args[22] & $args[24])	& !@ add name to list
		args[34] = arrsize($args[24])	& !@ get arr-size
		if args[34]>args[29]: args[29]=args[34]	& !@ get max arr-size
	else:
		msg "em.fewArrs.print: Array's name is not correct. <<[%args[22], %args[0]]>>: '<<$args[24]>>'"
	end
end
args[21] = len(%args[22])

if $args[2] = '':
if args[27]: !@ table
	$args[2] = {
		result = args[1]
		if 0:
			elseif $args[0] = 'arrs-empty': result = $args[4]
			elseif $args[0] = 'header':
				result += '<table border=1 cellpadding=5>'
				result += '<tr><th>#</th>'
					args[31], args[21] = 0, len(%args[2])
					loop while args[31] < args[21] step args[31] += 1:
						$args[24], %args[2] = %args[2]
						result += '<th><<$args[24]>></th>'
					end
				result += '</tr>'
			elseif $args[0] = 'row-start':
				result += '<tr><td><<args[3]>></td>'
			elseif $args[0] = 'cell':
				$args[4] = $iif($args[4], @em.html.to_mnemonics($args[4]), '&nbsp;')
				result += '<td><<$args[4]>></td>'
			elseif $args[0] = 'row-end': result += '</tr>'
			elseif $args[0] = 'footer': result += '</table>'
		end
	}
elseif args[28]: !@ only results
	$args[2] = {
		result = args[1]
		if 0:
			elseif $args[0] = 'arrs-empty': result = $args[4]
			elseif $args[0] = 'cell':
				if args[6] <> 0: result += '	'
				result += $args[4]
			elseif $args[0] = 'row-end':
				if args[3] < args[6]-1: result += @em.RN
		end
	}
else: !@ no table
	$args[2] = {
		result = args[1]
		if 0:
			elseif $args[0] = 'arrs-empty': result = $args[4]
			elseif $args[0] = 'cell':
				$args[24] = $iif(instr('$#%',$mid($args[5],1,1)),$mid($args[5],1,1), $arrtype($args[5], args[3]))
				if $args[24] = '$': $args[4] = "'<<$replace($args[4], '''', '''''')>>'"
				if args[6] <> 0: result += '	&	'
				result += '<<$args[5]>>[<<args[3]>>]=<<$args[4]>>'
			elseif $args[0] = 'row-end':
				if args[3] < args[6]-1: result += @em.RN
		end
	}
end
end

if args[29] = 0:
	!@ если размеры всех массивов равны нулю, выводим сообщение.
!@pp:if(em_fuse):include
	msg 'em.fewArrs.print: All your massives are empty.'
!@pp:endif
	!@ сообщение возвращается в результат
	result = dyneval($args[2], 'arrs-empty', result, %args[22], ?, $args[23])
	exit
end

!@ =========================================== P R I N T ===========================================

!@ до перебора строк, применяем форматирование:
result = dyneval($args[2], 'header', result, %args[22])

!@ #25 - с какого элемента начинать вывод
!@ #26 - до какого элемента продолжать вывод (больше на 1 для удобства)
!@ если мы превысили максимальный индекс, нужно приравнять начало к последнему возможному индексу
if args[25] > args[29] - 1: args[25] = args[29] - 1

if args[26] > args[29] or args[26] = -1:
	args[26] = args[29]
elseif args[26] <= args[25]:
	args[26] = args[25] + 1
end
!@ #32 - считает от #25 до #26-1 (индексы)
!@ следующий цикл выводит уже непосредственно результаты
loop args[32] = args[25] while args[32]<args[26] step args[32]+=1:
	!@ пока счётчик не достигнет предела
	result = dyneval($args[2], 'row-start', result, %args[22], args[32])
	!@ этот цикл выводит содержимое ячеек под одним индексом
	%args[0] = %args[22]
	loop args[31] = 0 while args[31]<args[21] step args[31] += 1:
		!@ перебираем весь список массивов
		$args[24], %args[0] = %args[0]
		$args[33] = $str(arritem($args[24],args[32]))
		result = dyneval($args[2], 'cell', result, %args[22], args[32], $args[33], $args[24], args[31])
		!@ 0:mode, 1:result, 2:arrs-names, 3:row-index, 4:value, 5:arr-name, 6:arr-number
	end
	result = dyneval($args[2], 'row-end', result, %args[22], args[32], ?, ?, args[26])
end
result = dyneval($args[2], 'footer', result, %args[22])
--- em.fewArrs.print ---------------------------------
!@pp:endif

!@pp:if(em_fewarrs_print!=True):off
!@pp:var(em_rn)
!@pp:var(em_html_to_mnemonics)
!@pp:endif

!@ $1 - Можно использовать следующие конструкции в любых комбинациях:
	* [only result] - выводит только содержимое массивов, не показывая их названий и номеров ячеек. Таблица при этом на экран выводиться не будет.
	* [no table] - выводит массивы на экран, но не облекает их в таблицу.
	* [range onscreen:N-M] - указываем границы вывода
	* [empty:TEXT] - что должна возвращать функция в случае, когда все массивы пустые.

!@ #21 - число массивов к выводу
!@ %22 - кортеж валидных имён массивов
!@ $23 - сообщение, если все массивы пусты.
!@ $24 - текущее имя массива
!@ #25 - с какого элемента начинать вывод
!@ #26 - до какого элемента продолжать вывод
!@ #27 - show table (0|1)
!@ #28 - only result (0|1)
!@ #29 - размер максимального массива
!@ $30 - управляющая конструкция, приведённая к нижнему регистру
!@ #31 - счётчик i
!@ #32 - счётчик b
!@ $33 - содержимое ячейки cell
!@ #34 - размер текущего массива this_size

Из-за того, что данная функция работает напрямую с данными из массивов было решено не использовать
здесь локальные переменные, чтобы случайно не перекрыть возможные названия массивов.

Функция не использует иных функций библиотеки

local $a, %b, $c, %d
$a[]='нулевая ячейка'
$a[]='первая ячейка'
$a[]='вторая ячейка'
$a[]=''
$a[]='четвёртая'' ячейка'
$a[]="пятая яче'йка"
$a[]=''
$a[]='седьмая ячейка'

%b[]= [0, 'zero']
%b[]= ['first', 1, 0]
%b[]= [2, 'second', 2]
%b[]= ['3']
%b[]=(3,5,6,'string',6)
%b[]='пятая ячейка'
%b[]='6'
%b[]='7'
@em.fewArrs.print('$a','%b')
@em.fewArrs.print('$a','%b', '[range onscreen:3-6]')
@em.fewArrs.print('$a','%b','[only result]')
@em.fewArrs.print('$a','%b','[no table]')
@em.fewArrs.print('$c','%d', '[empty:EMPTY ARRAYS]')
@em.fewArrs.print('$a','$b','[no table]','$f')
