QSP-Game Функция автотестов для easy.math

!@pp:if(em_autotest):include
# em.autotest
$args[0]=$lcase($args[0])
local $nr=@em.RN
$result = ''

if 0:
	! pass

!@ ------------------------------------- Вспомогательные функции -------------------------------------

	elseif $args[0]='em.dergb':
		$result = $dyneval({
			$result = $str([
				@em.deRGB(rgb(255,255,0)),
				@em.deRGB(rgb(0,98,98)),
				@em.deRGB(rgb(240,230,140,100)),
				@em.deRGB(rgb(240,230,140,100), '/wa'),
				@em.deRGB(rgb(240,230,140,237)),
			])
		})

	elseif $args[0]='em.str.get_word':
		$result = $dyneval({
			local $text="Январь|Февраль|Март|Апрель|Май|Июнь|Июль|Август|Сентябрь|Октябрь|Ноябрь|Декабрь"

			$result = @em.str.get_word($text)
			$result += @em.str.get_word($text,2)
			$result += @em.str.get_word($text,5)
			$result += @em.str.get_word($text,8)
			$result += @em.str.get_word($text,11)
			$result += @em.str.get_word($text,14)
			$result += @em.str.get_word('Декабрь',14)
		})

	elseif $args[0]='em.str.in_regexp':
		$result = $dyneval({
			$result = @em.str.in_regexp('([^][]*?)([^][]+?)([^><]*?)([^><]+?)([^}{]*?)([^}{]+?)([^)(]*?)([^)(]+?)'')([\s\S]*?)\1(:|=#)[\S]+(:|=#)([\S]+)')
		})

	elseif $args[0]='em.tag.get_cont':
		$result = $dyneval({
			local $text="[count:текст с пробелом:count] <cord:странный и непонятный текст:cord> log:п р о б е л ь н ы е и непробельные символы:log <color>ff8899</color> [tag]многа букав[/tag]"
			$result = ''

			$result += @em.tag.get_cont($text,'count')
			$result += @em.tag.get_cont($text,'cord')
			$result += @em.tag.get_cont($text,'log')
			$result += @em.tag.get_cont($text,'color')
			$result += @em.tag.get_cont($text,'tag')
		})

	elseif $args[0]='em.tag.get_num':
		$result = $dyneval({
			$result = ''
			local $text="[count:текст с пробелом] <cord:68> log:непробельные_символы color=#ff8899 tag='многа букав'"
			$result += '[' + @em.tag.get_num($text,'count')+ ']'
			$result += '[' + @em.tag.get_num($text,'cord')+ ']'
			$result += '[' + @em.tag.get_num($text,'log')+ ']'
			$result += '[' + @em.tag.get_num($text,'color')+ ']'
			$result += '[' + @em.tag.get_num($text,'tag')+ ']'
			$result += '[' + @em.tag.get_num($text,'tag/h')+ ']'
			$result += '[' + @em.tag.get_num($text,'color/h')+ ']'
		})

!@ ------------------------------------- Вспомогательные функции -------------------------------------

!@ ----------------------------------- Операции с дробными числами -----------------------------------

	elseif $args[0]='em.sqrt':
		$result=$dyneval({
			$result = ''
			$result+=@em.sqrt('1000',10000)
			$result+=@em.sqrt('16',10000)
			$result+=@em.sqrt('257',100000)
			$result+=@em.sqrt('257',10000)
			$result+=@em.sqrt('257',1000)
			$result+=@em.sqrt('257',100)
			$result+=@em.sqrt('2.1',100)
			$result+=@em.sqrt('259',100)
			$result+=@em.sqrt('260',100)
			$result+=@em.sqrt('1.69',100)
			$result+=@em.sqrt('0.69',10000)
		})

	elseif $args[0]='em.add':
		$result=$dyneval({
			$result = ''
			$result+=@em.add('9.05','-9')
			$result+=@em.add('9.05','-9.05')
			$result+=@em.add('9.05','9')
			$result+=@em.add('9.05','9.55','9.25')
			$result+=@em.add('9.99','9.999','9.9')
			$result+=@em.add('384.384','92.8',3)
			$result+=@em.add('283','126')
			$result+=@em.add('283','-126')
			$result+=@em.add('-283','126')
			$result+=@em.add('-283','-126')
			$result+=@em.add('-234','125','-13.7890303','3484889')
		})

	elseif $args[0]='em.div':
		$result=$dyneval ({
			$result = ''
			$result+=@em.div('9.05',"-9",10000)
			$result+=@em.div('9.05','-9.05',10000)
			$result+=@em.div('9.05',"10")
			$result+=@em.div('9.05',"9.55",10000)
			$result+=@em.div('9.99',"9.999",10000)
			$result+=@em.div('9.99',"9.999",1000000)
			$result+=@em.div('-1.69',"1.3",10000)
			$result+=@em.div('1.69',"1.3",10000)
			$result+=@em.div('-1.69',"-1.3",10000)
			$result+=@em.div('1.69',"-1.3",10000)
		})

	elseif $args[0]='em.mult':
		$result=$dyneval ({
			$result = ''
			$result+=@em.mult("38.4","2.5")
			$result+=@em.mult('9.05',"-9.05")
			$result+=@em.mult('9.05',"10")
			$result+=@em.mult('9.05',"9.55","9.25")
			$result+=@em.mult('9.99',"-9.999","9.9")
			$result+=@em.mult('2','2','2','2','2','2','2','2','2')
			$result+=@em.mult('-2','-2','-2','-2','-2','-2','-2','-2','-2')
		})

	elseif $args[0]='em.round':
		$result=$dyneval ({
			$result = ''
			$result+=@em.round("945.459","0.1")
			$result+=@em.round("945.459","0.1",'[down]')
			$result+=@em.round("945.444","0.1",'[up]')
			$result+=@em.round("945.459","0.01")
			$result+=@em.round("945.459","0.001")
			$result+=@em.round("945.459","1")
			$result+=@em.round("945.459","10")
			$result+=@em.round("945.459","100")
			$result+=@em.round("-945.459","10")
			$result+=@em.round("-945.459","0.01")
		})

	elseif $args[0]='em.simpl':
		$result=dyneval ({
			$result = ''
			$result+=@em.simpl('9.05',"-9")
			$result+=@em.simpl('9.05','-9.05')
			$result+=@em.simpl('9.05',"10")
			$result+=@em.simpl('9.05',"9.55")
			$result+=@em.simpl('9.99',"9.999")
			$result+=@em.simpl('-1.69',"1.3")
			$result+=@em.simpl('-1.69',"-1.3")
			$result+=@em.simpl('1.69',"1.3")
			$result+=@em.simpl('1.69',"-1.3")
		})

	elseif $args[0]='em.indiv':
		$result = $dyneval({
			$result = ''
			$result += @em.indiv(-950000,1000)
			$result += @em.indiv(64)
			$result += @em.indiv(64,8,1)
			$result += @em.indiv(64,7,100000)
			$result += @em.indiv(64,7)
			$result += @em.indiv(8,125)
			$result += @em.indiv(150,100,10)
			$result += @em.indiv(200,100,10)
		})

	elseif $args[0]='em.divdigs':
		$result = $dyneval({
			$result = ''
			$result += $str(@em.divdigs('0.64'))
			$result += $str(@em.divdigs('0.064'))
			$result += $str(@em.divdigs('0.640'))
			$result += $str(@em.divdigs('0.647777'))
			$result += $str(@em.divdigs('-7777.64'))
			$result += $str(@em.divdigs('-7777.646666666666666666666666'))
		})

	elseif $args[0]='em.dz':
		$result = $dyneval({
			$result = ''
			$result += @em.dz('64',100)
			$result += @em.dz('64.0080000',1)
			$result += @em.dz('64.0080000',100)
			$result += @em.dz('64.0080000',10000)
		})


	elseif $args[0]='em.undiv':
		$result = $dyneval({
			$result = ''
			$result += $str(@em.undiv('1',1000))
			$result += $str(@em.undiv('-1',1000))
			$result += $str(@em.undiv('0.123',100))
			$result += $str(@em.undiv('0.123',10))
			$result += $str(@em.undiv('0.123'))
			$result += $str(@em.undiv('1.23'))
		})

!@ ----------------------------------- Операции с дробными числами -----------------------------------

!@ --------------------------------------- Операции логические ---------------------------------------

	elseif $args[0]='em.byte.add':
		$result=$dyneval({
			$result = ''
			$result += @em.byte.add(998765,273)
			$result += @em.byte.add('9987Y5','-273')
			$result += @em.byte.add('999999','6273')
			$result += @em.byte.add('998705','5773')
		})

	elseif $args[0]='em.byte.dev':
		$result=$dyneval({
			$result = ''
			$result += @em.byte.dev(998765,273)
			$result += @em.byte.dev('9987Y5','-273')
			$result += @em.byte.dev('999999','6273')
			$result += @em.byte.dev('998705','5773')
		})

!@ --------------------------------------- Операции логические ---------------------------------------

!@ --------------------------------------- Операции  текстовые ---------------------------------------

	elseif $args[0]='em.arr.search':
		$result = $dyneval({
			local $mass
			$mass[0]='привет красное яблоко'
			$mass[1]='привет оранжевое яблоко'
			$mass[2]='привет жёлтое яблоко'
			$mass[3]='привет зелёное яблоко'
			$mass[4]='привет синее яблоко'
			$mass[5]='привет голубое яблоко'
			$mass[6]='привет фиолетовое яблоко'
			$mass[7]='привет чёрное яблоко'
			$mass[8]='привет зелёный банан'
			$mass[9]='привет голубое яблоко'
			$mass[10]='привет фиолетовое яблоко'
			$mass[11]='привет чёрный банан'
			$result = $str(@em.arr.search('$mass','зелён(ое|ый)'))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','[last]'))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','[past]'))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','',4,7))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','',3,8))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','[last]',3,8))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','',6))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','[last]',6))
		})

	elseif $args[0]='em.gen_uuid':
		$result = $dyneval({
			#result = 1
			loop local i=0 while i<10 step i+=1:
			    #result = strcomp(@em.gen_uuid(), '[A-Fa-f0-9]{8}(\-[A-Fa-f0-9]{4}){3}\-[A-Fa-f0-9]{12}')
			end
			$result = $str(#result)
		})

	elseif $args[0]='em.str.head_tail':
		$result = $dyneval({
			local $text="Январь|Февраль|Март|Апрель|Май|Июнь|Июль|Август|Сентябрь|Октябрь|Ноябрь|Декабрь"

			$result = $str([
			    @em.str.head_tail($text),
			    @em.str.head_tail($text,'А'),
			    @em.str.head_tail($text,'Ав'),
			    @em.str.head_tail($text,'брь')
			])
		})

	elseif $args[0]='em.str.random':
		$result = $dyneval({
			$result = $str([
				strcomp(@em.str.random(), '.+'),
				strcomp(@em.str.random(16,'[inc][\d][\z][\я]'), '[0-9A-Za-zА-Еа-еЖ-Яж-яёЁ]{16}'),
				strcomp(@em.str.random(16), '.{16}'),
				strcomp(@em.str.random(16,'[inc][\d][\z][\я]','$ @ !'), '[0-9A-Za-zА-Еа-еЖ-Яж-яёЁ$ @!]{16}'),
				strcomp(@em.str.random(16,'24680','  ©'), '([ ©]|[^24680]){16}'),
				strcomp(@em.str.random(16,'2 4 6 8 0','  ©'), '([ ©]|[^24680]){16}')
			])
		})

	elseif $args[0]='em.str.thin':
		$result=$dyneval({
			$result = $str([
				@em.str.thin('профессура'),
				@em.str.thin('профессура',1,'|'),
				@em.str.thin('профессура',1,'|','[right]'),
				@em.str.thin('профессура',1,'|','[left]'),
				@em.str.thin('профессура',1,'|','[right][left]'),
				@em.str.thin('профессура',3,'|'),
				@em.str.thin('профессура',3,'|','[up]'),
				@em.str.thin('профессура',3,'|','[left]'),
				@em.str.thin('профессура',2,'|','[right]'),
				@em.str.thin('профессура',1,'||','[left] [right]')
			])
		})

	elseif $args[0]='em.zero':
		$result=$dyneval({
			$result = $str([
				@em.zero(13),
				@em.zero(13,'1'),
				@em.zero(13,'10'),
				@em.zero(13,'a'),
				@em.zero(3,'bla')
			])
		})

!@ --------------------------------------- Операции  текстовые ---------------------------------------

!@ ------------------------------ Операции с шестнадцатеричными числами ------------------------------

	elseif $args[0]='em.col.add':
		$result = $dyneval({
			$result = $str([
				@em.col.add('ff0000','-44'),
				@em.col.add('000000','-44'),
				@em.col.add('dd0000','22'),
				@em.col.add('dd8822','-44'),
				@em.col.add('dd8822','44'),
				@em.col.add('dd882299','44')
			])
		})

	elseif $args[0]='em.col.in_rgb':
		$result = $dyneval({
			$result = $str([
				@em.col.in_rgb('ff0000'),
				@em.col.in_rgb('000000'),
				@em.col.in_rgb('dd0000'),
				@em.col.in_rgb('dd8822'),
				@em.col.in_rgb('ffmm00'),
				@em.col.in_rgb('-0000ff'),
				@em.col.in_rgb('238c9088')
			])
		})

	elseif $args[0]='em.col.inv':
		$result = $dyneval({
			$result = $str([
				@em.col.inv('000000'),
				@em.col.inv('ffffff'),
				@em.col.inv('238c90'),
				@em.col.inv('902b10'),
				@em.col.inv('c7c000'),
				@em.col.inv('07c701'),
				@em.col.inv('c7c00084'),
				@em.col.inv('07c7014d')
			])
		})

!@ ------------------------------ Операции с шестнадцатеричными числами ------------------------------

elseif $args[0]='em.fewarrs.print':
	$result=$dyneval({
		local $a, %b, $c, %d
		$result = ''
		$a[]='нулевая ячейка'
		$a[]='первая ячейка'
		$a[]='вторая ячейка'
		$a[]=''
		$a[]='четвёртая'' ячейка'
		$a[]="пятая яче'йка"
		$a[]=''
		$a[]='седьмая ячейка'

		%b[]= [0, 'zero']
		%b[]= ['first', 1, 0]
		%b[]= [2, 'second', 2]
		%b[]= ['3']
		%b[]=(3,5,6,'string',6)
		%b[]='пятая ячейка'
		%b[]='6'
		%b[]='7'
		$result += @em.fewArrs.print('$a','%b')
		$result += @em.fewArrs.print('$a','%b', '[range onscreen:3-6]')
		$result += @em.fewArrs.print('$a','%b','[only result]')
		$result += @em.fewArrs.print('$a','%b','[no table]')
		$result += @em.fewArrs.print('$c','%d', '[empty:EMPTY ARRAYS]')
	})

elseif $args[0]='em.arr.print':
	$result=$dyneval({
		$result = ''
		local $a
		$a[]='нулевая ячейка'
		$a[]='   первая ячейка   '
		$a[]=' вторая ячейка'
		$a[]=''
		$a[]=(1,2,3,5,6)
		$a[]='   пятая ячейка'
		$a[]=''
		$a[]='седьмая ячейка'

		$result+=@em.arr.print('$a')+$nr
		$result+=@em.arr.print('$a','[only result]')+$nr
		$result+=@em.arr.print('$a','[trim]')+$nr
		$result+=@em.arr.print('$a','[trim] [only result]',[2,5],'|')+$nr
		$result+=@em.arr.print('$a','[trim] [only result] [with last]',[2,5],'|')+$nr
	})
elseif $args[0]='em.arr.insert':
	$result=$dyneval({
		$result = ''
		local mass
		mass[0]=574
		mass[1]=668
		mass[2]=413
		mass[3]=765
		mass[4]=478
		mass[5]=205
		mass[6]=701
		mass[7]=272

		@@em.arr.insert 'mass',6,4
		$result+=@em.arr.print('mass')
	})
elseif $args[0]='em.arr.clear':
	$result=$dyneval({
		$result = ''
		local i
		i[0]=1
		i[1]=2
		i[2]=3
		i[3]=1
		i[4]=2
		i[5]=3
		i[6]=1
		i[7]=2

		@@em.arr.clear 'i', 2
		$result=@em.arr.print('i')
	})
elseif $args[0]='em.arr.desort':
	$result = $dyneval({
		$result = ''
		local old_mass, em_array, new_mass
		old_mass[0]=949
		old_mass[1]=913
		old_mass[2]=269
		old_mass[3]=901
		old_mass[4]=257
		old_mass[5]=561
		old_mass[6]=529
		old_mass[7]=293
		!@ сортируем массив
		@@em.arr.sort 'old_mass',0,'em_array'
		$result+=@em.arr.print('old_mass')+@em.RN
		$result+=@em.arr.print('em_array')+@em.RN
		!@ восстанавливаем исходный массив в новом массиве
		@@em.arr.deSort 'old_mass','em_array','new_mass'
		$result+=@em.arr.print('new_mass')
	})
elseif $args[0]='em.arr.sort':
	$result=$dyneval({
		$result = ''
		old_mass[0]=157
		old_mass[1]=250
		old_mass[2]=709
		old_mass[3]=413
		old_mass[4]=532
		old_mass[5]=779
		old_mass[6]=730
		old_mass[7]=565

		@@em.arr.sort('old_mass')
		$result+=@em.arr.print('old_mass')+@em.RN

		old_mass[0]=966
		old_mass[1]=812
		old_mass[2]=796
		old_mass[3]=304
		old_mass[4]=678
		old_mass[5]=118
		old_mass[6]=901
		old_mass[7]=132

		@@em.arr.sort('old_mass',0,'em_array')
		$result+=@em.arr.print('old_mass')+@em.RN
		$result+=@em.arr.print('em_array')+@em.RN

		%old_mass[0]=[967, 'голова']
		%old_mass[1]=[629, 'плечи']
		%old_mass[2]=[541, 'руки']
		%old_mass[3]=[290, 'торс']
		%old_mass[4]=[852, 'бёдра']
		%old_mass[5]=[334, 'голени']
		%old_mass[6]=[318, 'ступни']
		%old_mass[7]=[529, 'нишваа']

		@@em.arr.sort('%old_mass',0,'em_array','%new_mass')

		$result+=@em.arr.print('%old_mass')+@em.RN
		$result+=@em.arr.print('em_array')+@em.RN
		$result+=@em.arr.print('%new_mass')+@em.RN

		$mass[0]='88ff88'
		$mass[1]='ff00ff'
		$mass[2]='0ff0f8'
		$mass[3]='ffffff'
		$mass[4]='8888ff'
		$mass[5]='fff8f8'

		@@em.arr.sort('$mass',1,'em_array')
		$result+=@em.arr.print('$mass')+@em.RN
		$result+=@em.arr.print('em_array')
	})
elseif $args[0]='em.arr.restand':
	$result = $dyneval({
		$result = ''
		$arr_mass[0]='голова'
		$arr_mass[1]='плечи'
		$arr_mass[2]='грудь'
		$arr_mass[3]='живот'
		$arr_mass[4]='бёдра'
		$arr_mass[5]='колени'
		$arr_mass[6]='икры'
		$arr_mass[7]='ступни'

		old_mass[0]=722
		old_mass[1]=136
		old_mass[2]=788
		old_mass[3]=177
		old_mass[4]=780
		old_mass[5]=97
		old_mass[6]=649
		old_mass[7]=75

		@@em.arr.sort 'old_mass',0,'em_array'
		@@em.arr.restand '$arr_mass','em_array','$new_mass'

		$result+=@em.arr.print('old_mass')+@em.RN
		$result+=@em.arr.print('em_array')+@em.RN
		$result+=@em.arr.print('$new_mass')
	})
elseif $args[0]='em.arr.simpl':
	$result=$dyneval({
		$result = ''
		local mass1, mass2, mass3
		mass1[0]=455
		mass1[1]=705
		mass1[2]=967
		mass1[3]=452
		mass1[4]=829
		mass1[5]=84
		mass1[6]=983
		mass1[7]=824

		mass2[0]=455
		mass2[1]=705
		mass2[2]=967
		mass2[3]=452
		mass2[4]=829
		mass2[5]=84
		mass2[6]=983
		mass2[7]=824

		mass3[0]=983
		mass3[1]=967
		mass3[2]=829
		mass3[3]=824
		mass3[4]=705
		mass3[5]=455
		mass3[6]=452
		mass3[7]=84

		$result+=$str(@em.arr.simpl('mass1','mass2'))
		$result+=$str(@em.arr.simpl('mass1','mass3'))
		$result+=$str(@em.arr.simpl('mass1','mass3','[simp]'))
	})
elseif $args[0]='em.arr.concatenate':
	$result=$dyneval({
		local old_mass, mass, arr_mass, em_result
		old_mass[0]=967
		old_mass[1]=629
		old_mass[2]=541
		old_mass[3]=290
		old_mass[4]=852
		old_mass[5]=334
		old_mass[6]=318
		old_mass[7]=529

		mass[0]='88ff88'
		mass[1]='ff00ff'
		mass[2]='0ff0f8'
		mass[3]='ffffff'
		mass[4]='8888ff'
		mass[5]='fff8f8'

		arr_mass[0]='голова'
		arr_mass[1]='плечи'
		arr_mass[2]='грудь'
		arr_mass[3]='живот'
		arr_mass[4]='бёдра'
		arr_mass[5]='колени'
		arr_mass[6]='икры'
		arr_mass[7]='ступни'


		@@em.arr.concatenate 'em_result', 'old_mass', 'mass', 'arr_mass'

		loop local i,size=0,arrsize('em_result') while i<size step i+=1:
		    $result+="%em_result[<<i>>]=<<em_result[i]>>"
		end
		})

!@ elseif $args[0]='em.str.in_arr':
!@ 		$result=$dyneval({
!@ local $text, $mass_ex_1, $mass_ex_2, $mass_ex_3
!@ local $mass_res_1, $mass_res_2, $mass_res_3
!@ $text="Адское Пекло и Небеса -
!@ Я весь мир мечтаю продать.
!@ Время - деньги. Пусть стрелки бегут на часах -
!@ И мне нечего больше желать."
!@ $mass_ex_1[0]='Адское Пекло и Небеса -'
!@ $mass_ex_1[1]='Я весь мир мечтаю продать.'
!@ $mass_ex_1[2]='Время - деньги. Пусть стрелки бегут на часах -'
!@ $mass_ex_1[3]='И мне нечего больше желать.'
!@ $mass_ex_2[0]='Адское'
!@ $mass_ex_2[1]='Пекло'
!@ $mass_ex_2[2]='и'
!@ $mass_ex_2[3]='Небеса'
!@ $mass_ex_2[4]='-
!@ Я'
!@ $mass_ex_2[5]='весь'
!@ $mass_ex_2[6]='мир'
!@ $mass_ex_2[7]='мечтаю'
!@ $mass_ex_2[8]='продать.
!@ Время'
!@ $mass_ex_2[9]='-'
!@ $mass_ex_2[10]='деньги.'
!@ $mass_ex_2[11]='Пусть'
!@ $mass_ex_2[12]='стрелки'
!@ $mass_ex_2[13]='бегут'
!@ $mass_ex_2[14]='на'
!@ $mass_ex_2[15]='часах'
!@ $mass_ex_2[16]='-
!@ И'
!@ $mass_ex_2[17]='мне'
!@ $mass_ex_2[18]='нечего'
!@ $mass_ex_2[19]='больше'
!@ $mass_ex_2[20]='желать.'
!@ $mass_ex_3[0]='Адское'
!@ $mass_ex_3[1]='Пекло'
!@ $mass_ex_3[2]='и'
!@ $mass_ex_3[3]='Небеса'
!@ $mass_ex_3[4]='Я'
!@ $mass_ex_3[5]='весь'
!@ $mass_ex_3[6]='мир'
!@ $mass_ex_3[7]='мечтаю'
!@ $mass_ex_3[8]='продать'
!@ $mass_ex_3[9]='Время'
!@ $mass_ex_3[10]='деньги'
!@ $mass_ex_3[11]='Пусть'
!@ $mass_ex_3[12]='стрелки'
!@ $mass_ex_3[13]='бегут'
!@ $mass_ex_3[14]='на'
!@ $mass_ex_3[15]='часах'
!@ $mass_ex_3[16]='И'
!@ $mass_ex_3[17]='мне'
!@ $mass_ex_3[18]='нечего'
!@ $mass_ex_3[19]='больше'
!@ $mass_ex_3[20]='желать'
!@ @em.str.in_arr($text, '$mass_res_1', @em.RN,'')

!@ loop local i,size=0,arrsize('$mass_res_1') while i<size step i+=1:
!@ 	if $mass_res_1[i]<>$mass_ex_1[i]: result-=1 & *pl $mass_res_1[i] + '<>' + $mass_ex_1[i]
!@ end

!@ @em.str.in_arr($text,'$mass_res_2',' ','')

!@ loop local i,size=0,arrsize('$mass_res_1') while i<size step i+=1:
!@ 	if $mass_res_2[i]<>$mass_ex_2[i]: result-=1 & *pl $mass_res_2[i] + '<>' + $mass_ex_2[i]
!@ end

!@ @em.str.in_arr($text,'$mass_res_3','("|!|\?|-|,|;|:|\.| |'+@em.RN+')','[notspace] [regular]')

!@ loop local i,size=0,arrsize('$mass_res_3') while i<size step i+=1:
!@ 	if $mass_res_3[i]<>$mass_ex_3[i]: result-=1 & *pl $mass_res_3[i] + '<>' + $mass_ex_3[i]
!@ end
!@ $result=$str(result)
!@ 		})

elseif $args[0]='em.hex.add':
	$result=$dyneval({
		$result = ''
		$result+=@em.hex.add('ffeeff','a1')+$nr
		$result+=@em.hex.add('f0','f')+$nr
		$result+=@em.hex.add('ff','1')+$nr
		$result+=@em.hex.add('ffe','1')+$nr
		$result+=@em.hex.add('fef','1')+$nr
		$result+=@em.hex.add('aaaaaa','cc')+$nr
	})
end
--- em.autotest ---------------------------------
!@pp:endif
