QSP-Game часть автотеста, отвечающая за сравнение


!@ %0 - функции на автотест (если пустой, проверяются все)
!@ $1 - управление. compile ← посимвольное сравнение ожидаемого и полученного значений.
!@pp:if(em_autotest):include
# em.autotest.self
local $res, $example_, $funcs_, $comms_
$comms_ = $str(%args[0])

!@ -------------- Вспомогательные функции --------------

	!@ em.deRGB
	if instr($comms_, "'em.dergb'") or $comms_ = '[]':
		$funcs_[] = 'em.dergb'
		$example_['em.deRGB'] = '[[255, 255, 0, 255], [0, 98, 98, 255], [240, 230, 140, 100], [240, 230, 140, 100], [240, 230, 140, 237]]'
	end

	!@ em.str.get_word
	if instr($comms_, "'em.str.get_word'") or $comms_ = '[]':
		$funcs_[] = 'em.str.get_word'
		$example_['em.str.get_word'] = 'ЯнварьФевральМайАвгустНоябрьДекабрьДекабрь'
	end

	!@ em.str.in_regexp
	if instr($comms_, "'em.str.in_regexp'") or $comms_ = '[]':
		$funcs_[] = 'em.str.in_regexp'
		$example_['em.str.in_regexp'] = '\(\[\\^\]\[\]\*\?\)\(\[\\^\]\[\]\+\?\)\(\[\\^><\]\*\?\)\(\[\\^><\]\+\?\)\(\[\\^\}\{\]\*\?\)\(\[\\^\}\{\]\+\?\)\(\[\\^\)\(\]\*\?\)\(\[\\^\)\(\]\+\?\)''\)\(\[\\s\\S\]\*\?\)\\1\(\:\|\=#\)\[\\S\]\+\(\:\|\=#\)\(\[\\S\]\+\)'
	end

	!@ em.tag.get_cont
	if instr($comms_, "'em.tag.get_cont'") or $comms_ = '[]':
		$funcs_[] = 'em.tag.get_cont'
		$example_['em.tag.get_cont'] = 'текст с пробеломстранный и непонятный текстп р о б е л ь н ы е и непробельные символыff8899многа букав'
	end

	!@ em.tag.get_num
	if instr($comms_, "'em.tag.get_num'") <> 0 or $args[0] = '':
		$funcs_[] = 'em.tag.get_num'
		$example_['em.tag.get_num'] = "[текст с пробелом][68][непробельные_символы][ff8899][многа букав][][ff8899]"
	end

