QSP-Game часть автотеста, отвечающая за сравнение


!@ %0 - функции на автотест (если пустой, проверяются все)
!@ $1 - управление. compile ← посимвольное сравнение ожидаемого и полученного значений.
!@pp:if(em_autotest):include
# em.autotest.self
local $res, $example_, $funcs_, $comms_
$comms_ = $str(%args[0])

*pl "Start of Autotest." & wait 500
loop local i,size=0,arrsize('$funcs_') while i<size step i+=1:
	if loc($funcs_[i]):
		*pl "Function '<<$funcs_[i]>>' is exist."
		wait 500
		$res=@em.autotest.base.tests($funcs_[i])
		if $res=$example_[$funcs_[i]]:
			*pl "Autotest of '<<$funcs_[i]>>' completed. All Ok!"
			wait 500
		else
			*pl "Autotest Error. Dif Result:"
			usehtml = 1
			*pl "<table border=1 cellspacing=5><tr><td>Еxpected results:</td><td>Obtained results:</td></tr><tr><td><<@em.html.to_mnemonics($example_[$funcs_[i]])>></td><td><<@em.html.to_mnemonics($res)>></td></tr></table>"
			if $args[1]='compile':
				local $f,$r
				loop local j,size=1,max(len($example_[$funcs_[i]]),len($res)) while j<=size step j+=1:
					$f=$mid($example_[$funcs_[i]],j,1)
					$r=$mid($res,j,1)
					if $f<>$r: *pl "[<<j>>]<<$f>>	<<$r>> "
				end
			end
			wait 500
		end
	else
		*pl "Function '<<$funcs_[i]>>' doesn't exist. Location not found."
		wait 500
	end
end
*pl "End of Autotest."
--- em.autotest.self ---------------------------------
!@pp:endif
