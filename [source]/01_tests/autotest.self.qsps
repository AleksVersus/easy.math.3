	if instr($comms_, "'em.html.clr_pref'") or $comms_ = '[]':
		$funcs_[] = 'em.html.clr_pref'
		$example_['em.html.clr_pref'] = '<table width=50% border=1><tr><td>первая ячейка первой строки</td><td>вторая ячейка первой строки</td></tr><tr><td>первая ячейка второй строки</td><td>вторая ячейка второй строки</td></tr></table>'
	end

	!@ em.html.to_mnenonic
	if instr($comms_, "'em.html.to_mnemonic'") or $comms_ = '[]':
		$funcs_[] = 'em.html.to_mnemonic'
		$example_['em.html.to_mnemonic'] = '&lt;table width=50% border=1&gt;&lt;tr&gt;&lt;td&gt;&amp;первая ячейка первой строки&lt;/td&gt;&lt;td&gt;вторая ячейка первой строки&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;первая ячейка второй строки&lt;/td&gt;&lt;td&gt;вторая ячейка второй строки&amp;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;'
	end


!@ ------------------- операции с HTML ------------------





!@ ---------------- операции с кортежами ----------------

	!@ em.str.to_tpl
	if instr($comms_, "'em.str.to_tpl'") or $comms_ = '[]':
		$funcs_[] = 'em.str.to_tpl'
		$example_['em.str.to_tpl'] = "[852, 'бёдра', [3, 5, 6, 'string', 6]]"
	end

	!@ em.tpl.get
	if instr($comms_, "'em.tpl.get'") or $comms_ = '[]':
		$funcs_[] = 'em.tpl.get'
		$example_['em.tpl.get'] = "[852, 'бёдра', [3, 5, 6, 'string', 6]]"
	end

!@ ---------------- операции с кортежами ----------------


*pl "Start of Autotest." & wait 500
loop local i,size=0,arrsize('$funcs_') while i<size step i+=1:
	if loc($funcs_[i]):
		*pl "Function '<<$funcs_[i]>>' is exist."
		wait 500
		$res=@em.autotest($funcs_[i])
		if $res=$example_[$funcs_[i]]:
			*pl "Autotest of '<<$funcs_[i]>>' completed. All Ok!"
			wait 500
		else
			*pl "Autotest Error. Dif Result:"
			usehtml = 1
			*pl "<table border=1 cellspacing=5><tr><td>Еxpected results:</td><td>Obtained results:</td></tr><tr><td><<@em.html.to_mnemonics($example_[$funcs_[i]])>></td><td><<@em.html.to_mnemonics($res)>></td></tr></table>"
			if $args[1]='compile':
				local $f,$r
				loop local j,size=1,max(len($example_[$funcs_[i]]),len($res)) while j<=size step j+=1:
					$f=$mid($example_[$funcs_[i]],j,1)
					$r=$mid($res,j,1)
					if $f<>$r: *pl "[<<j>>]<<$f>>	<<$r>> "
				end
			end
			wait 500
		end
	else
		*pl "Function '<<$funcs_[i]>>' doesn't exist. Location not found."
		wait 500
	end
end
*pl "End of Autotest."
--- em.autotest.self ---------------------------------
!@pp:endif
