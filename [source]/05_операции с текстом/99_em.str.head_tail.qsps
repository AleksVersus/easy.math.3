QSP-Game Разделяет строку на голову и хвост, разделитель в выдачу не попадает

!@ $0 - строка
!@ $1 - разделитель
!@ %r - [строка до разделителя, строка после разделителя]
!@pp:if(em_str_head_tail):include
# em.str.head_tail
if $args[1] = '': $args[1] = '|'
local i = instr($args[0], $args[1])
%result = [$mid($args[0], 1, i-1), $mid($args[0], i+len($args[1]))]
--- em.str.head_tail
 ---------------------------------
!@pp:endif

fgtRAZfghdjks
   ^^^
1234567890
		  123

local $text="Январь|Февраль|Март|Апрель|Май|Июнь|Июль|Август|Сентябрь|Октябрь|Ноябрь|Декабрь"

$result = $str([
    @em.str.head_tail($text),
    @em.str.head_tail($text,'А'),
    @em.str.head_tail($text,'Ав'),
    @em.str.head_tail($text,'брь')
])
