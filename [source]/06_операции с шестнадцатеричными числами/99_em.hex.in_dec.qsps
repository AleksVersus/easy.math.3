QSP-Game Функция, конвертирующая шестнадцатеричное число в десятеричное

!@ $0 - шестнадцатеричное число
!@ #r - десятеричное число
!@pp:if(em_hex_in_dec):include
# em.hex.in_dec
$args[0] = $lcase($args[0])	& !@ переводим в нижний регистр все символы hex-числа (строка)
local $last_symbol_
result = 0
loop local i, t = 0, 0 while i < len($args[0]) step i += 1:
	!@ идём по строке слева направо: result = result * 16 + цифра
	$last_symbol_ = $mid($args[0], i+1, 1) & !@ вырезаем текущую hex-цифру
	t = instr('0123456789abcdef', $last_symbol_) - 1 & !@ определяем значение цифры по таблице сопоставления
	result = result * 16 + t	& !@ накапливаем результат
end
--- em.hex.in_dec ---------------------------------
!@pp:endif
