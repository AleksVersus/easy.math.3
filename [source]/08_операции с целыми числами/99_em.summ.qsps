QSP-Game Суммирует все элементы массива

!@ $0 - название массива
!@ $1 - разделитель или ключ /se. (только для строковых значений) Если указан ключ - без разделителя.
!@pp:if(em_summ):include
# em.summ
$args[1] = $iif(no $args[1], ' ', $iif($lcase($args[1]) = '/se', '', $args[1])) 
if $args[0]='': exit	& !@ если не указано имя массива. Защита от дурака
!@ префикс типа определяем по указанному в имени, или по типу первого значения в мессиве.
$args[21] = $iif(instr('$%#', $mid($args[0],1,1)), $mid($args[0],1,1), arrtype($args[0], 0))
#args[22] = arrsize($args[0])
if $args[21] = '#':
	!@ числа складываем
	#result = 0
	loop #args[23]=0 while args[23] < args[22] step args[23]+=1:
		#result += #arritem($args[0], args[23])
	end
	exit
elseif $args[21] = '%':
	!@ кортежи конкатенируем
	%result = []
	loop #args[23]=0 while args[23] < args[22] step args[23]+=1:
		%result = (%result & %arritem($args[0], args[23]))
	end
	exit
else:
	!@ не кортежи и не числа считаем строками!
	$result = ''
	!@ для строковых массивов работает конкатенация
	loop #args[23]=0 while args[23] < args[22] step args[23]+=1:
		if args[23]>0: $result += $args[1]
		$result += $arritem($args[0], args[23])
	end
	exit
end
--- em.summ ---------------------------------
!@pp:endif
Функция не использует иных функций библиотеки

!@ $21 - префикс типа
!@ #22 - размер массива
!@ #23 - счётчик

mass[]=12
mass[]=99
mass[]=123
@em.summ('mass')
