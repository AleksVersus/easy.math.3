QSP-Game Функция автотестов для easy.math

!@pp:if(em_autotest):include
# em.autotest.base.tests
$args[0]=$lcase($args[0])
$result = ''

if 0:
	! pass

!@ ------------------------------------- Вспомогательные функции -----------------------------------

	elseif $args[0]='em.dergb':
		$result = $dyneval({
			$result = $str([
				@em.deRGB(rgb(255,255,0)), @em.deRGB(rgb(0,98,98)),	@em.deRGB(rgb(240,230,140,100)),
				@em.deRGB(rgb(240,230,140,100), '/wa'),	@em.deRGB(rgb(240,230,140,237))
			])
		})

	elseif $args[0]='em.str.get_word':
		$result = $dyneval({
			local $text="Январь|Февраль|Март|Апрель|Май|Июнь|Июль|Август|Сентябрь|Октябрь|Ноябрь|Декабрь"

			$result = @em.str.get_word($text) + @em.str.get_word($text,2) + @em.str.get_word($text,5)
			$result += @em.str.get_word($text,8) + @em.str.get_word($text,11) + @em.str.get_word($text,14)
			$result += @em.str.get_word('Декабрь',14)
		})

	elseif $args[0]='em.str.in_regexp':
		$result = $dyneval({
			$result = @em.str.in_regexp('([^][]*?)([^][]+?)([^><]*?)([^><]+?)([^}{]*?)([^}{]+?)([^)(]*?)([^)(]+?)'')([\s\S]*?)\1(:|=#)[\S]+(:|=#)([\S]+)')
		})

	elseif $args[0]='em.tag.get_cont':
		$result = $dyneval({
			local $text="[count:текст с пробелом:count] <cord:странный и непонятный текст:cord> log:п р о б е л ь н ы е и непробельные символы:log <color>ff8899</color> [tag]многа букав[/tag]"
			$result = ''

			$result += @em.tag.get_cont($text,'count')
			$result += @em.tag.get_cont($text,'cord')
			$result += @em.tag.get_cont($text,'log')
			$result += @em.tag.get_cont($text,'color')
			$result += @em.tag.get_cont($text,'tag')
		})

	elseif $args[0]='em.tag.get_num':
		$result = $dyneval({
			$result = ''
			local $text="[count:текст с пробелом] <cord:68> log:непробельные_символы color=#ff8899 tag='многа букав'"
			$result += '[' + @em.tag.get_num($text,'count')+ ']'
			$result += '[' + @em.tag.get_num($text,'cord')+ ']'
			$result += '[' + @em.tag.get_num($text,'log')+ ']'
			$result += '[' + @em.tag.get_num($text,'color')+ ']'
			$result += '[' + @em.tag.get_num($text,'tag')+ ']'
			$result += '[' + @em.tag.get_num($text,'tag/h')+ ']'
			$result += '[' + @em.tag.get_num($text,'color/h')+ ']'
		})

!@ ------------------------------------- Вспомогательные функции -----------------------------------

!@ ----------------------------------- Операции с дробными числами ---------------------------------

	elseif $args[0]='em.sqrt':
		$result=$dyneval({
			$result = ''
			$result+=@em.sqrt('1000',10000)
			$result+=@em.sqrt('16',10000)
			$result+=@em.sqrt('257',100000)
			$result+=@em.sqrt('257',10000)
			$result+=@em.sqrt('257',1000)
			$result+=@em.sqrt('257',100)
			$result+=@em.sqrt('2.1',100)
			$result+=@em.sqrt('259',100)
			$result+=@em.sqrt('260',100)
			$result+=@em.sqrt('1.69',100)
			$result+=@em.sqrt('0.69',10000)
		})

	elseif $args[0]='em.add':
		$result=$dyneval({
			$result = ''
			$result+=@em.add('9.05','-9')
			$result+=@em.add('9.05','-9.05')
			$result+=@em.add('9.05','9')
			$result+=@em.add('9.05','9.55','9.25')
			$result+=@em.add('9.99','9.999','9.9')
			$result+=@em.add('384.384','92.8',3)
			$result+=@em.add('283','126')
			$result+=@em.add('283','-126')
			$result+=@em.add('-283','126')
			$result+=@em.add('-283','-126')
			$result+=@em.add('-234','125','-13.7890303','3484889')
		})

	elseif $args[0]='em.div':
		$result=$dyneval ({
			$result = ''
			$result+=@em.div('9.05',"-9",10000)
			$result+=@em.div('9.05','-9.05',10000)
			$result+=@em.div('9.05',"10")
			$result+=@em.div('9.05',"9.55",10000)
			$result+=@em.div('9.99',"9.999",10000)
			$result+=@em.div('9.99',"9.999",1000000)
			$result+=@em.div('-1.69',"1.3",10000)
			$result+=@em.div('1.69',"1.3",10000)
			$result+=@em.div('-1.69',"-1.3",10000)
			$result+=@em.div('1.69',"-1.3",10000)
		})

	elseif $args[0]='em.mult':
		$result=$dyneval ({
			$result = ''
			$result+=@em.mult("38.4","2.5")
			$result+=@em.mult('9.05',"-9.05")
			$result+=@em.mult('9.05',"10")
			$result+=@em.mult('9.05',"9.55","9.25")
			$result+=@em.mult('9.99',"-9.999","9.9")
			$result+=@em.mult('2','2','2','2','2','2','2','2','2')
			$result+=@em.mult('-2','-2','-2','-2','-2','-2','-2','-2','-2')
		})

	elseif $args[0]='em.round':
		$result=$dyneval ({
			$result = ''
			$result+=@em.round("945.459","0.1")
			$result+=@em.round("945.459","0.1",'[down]')
			$result+=@em.round("945.444","0.1",'[up]')
			$result+=@em.round("945.459","0.01")
			$result+=@em.round("945.459","0.001")
			$result+=@em.round("945.459","1")
			$result+=@em.round("945.459","10")
			$result+=@em.round("945.459","100")
			$result+=@em.round("-945.459","10")
			$result+=@em.round("-945.459","0.01")
		})

	elseif $args[0]='em.simpl':
		$result=dyneval ({
			$result = ''
			$result+=@em.simpl('9.05',"-9")
			$result+=@em.simpl('9.05','-9.05')
			$result+=@em.simpl('9.05',"10")
			$result+=@em.simpl('9.05',"9.55")
			$result+=@em.simpl('9.99',"9.999")
			$result+=@em.simpl('-1.69',"1.3")
			$result+=@em.simpl('-1.69',"-1.3")
			$result+=@em.simpl('1.69',"1.3")
			$result+=@em.simpl('1.69',"-1.3")
		})

	elseif $args[0]='em.indiv':
		$result = $dyneval({
			$result = ''
			$result += @em.indiv(-950000,1000)
			$result += @em.indiv(64)
			$result += @em.indiv(64,8,1)
			$result += @em.indiv(64,7,100000)
			$result += @em.indiv(64,7)
			$result += @em.indiv(8,125)
			$result += @em.indiv(150,100,10)
			$result += @em.indiv(200,100,10)
		})

	elseif $args[0]='em.divdigs':
		$result = $dyneval({
			$result = ''
			$result += $str(@em.divdigs('0.64'))
			$result += $str(@em.divdigs('0.064'))
			$result += $str(@em.divdigs('0.640'))
			$result += $str(@em.divdigs('0.647777'))
			$result += $str(@em.divdigs('-7777.64'))
			$result += $str(@em.divdigs('-7777.646666666666666666666666'))
		})

	elseif $args[0]='em.dz':
		$result = $dyneval({
			$result = ''
			$result += @em.dz('64',100)
			$result += @em.dz('64.0080000',1)
			$result += @em.dz('64.0080000',100)
			$result += @em.dz('64.0080000',10000)
		})


	elseif $args[0]='em.undiv':
		$result = $dyneval({
			$result = ''
			$result += $str(@em.undiv('1',1000))
			$result += $str(@em.undiv('-1',1000))
			$result += $str(@em.undiv('0.123',100))
			$result += $str(@em.undiv('0.123',10))
			$result += $str(@em.undiv('0.123'))
			$result += $str(@em.undiv('1.23'))
		})

!@ ----------------------------------- Операции с дробными числами ---------------------------------

!@ --------------------------------------- Операции логические -------------------------------------

	elseif $args[0]='em.byte.add':
		$result=$dyneval({
			$result = ''
			$result += @em.byte.add(998765,273)
			$result += @em.byte.add('9987Y5','-273')
			$result += @em.byte.add('999999','6273')
			$result += @em.byte.add('998705','5773')
		})

	elseif $args[0]='em.byte.dev':
		$result=$dyneval({
			$result = ''
			$result += @em.byte.dev(998765,273)
			$result += @em.byte.dev('9987Y5','-273')
			$result += @em.byte.dev('999999','6273')
			$result += @em.byte.dev('998705','5773')
		})

!@ --------------------------------------- Операции логические -------------------------------------

!@ --------------------------------------- Операции  текстовые -------------------------------------

	elseif $args[0]='em.arr.search':
		$result = $dyneval({
			local $mass
			$mass[0]='привет красное яблоко'
			$mass[1]='привет оранжевое яблоко'
			$mass[2]='привет жёлтое яблоко'
			$mass[3]='привет зелёное яблоко'
			$mass[4]='привет синее яблоко'
			$mass[5]='привет голубое яблоко'
			$mass[6]='привет фиолетовое яблоко'
			$mass[7]='привет чёрное яблоко'
			$mass[8]='привет зелёный банан'
			$mass[9]='привет голубое яблоко'
			$mass[10]='привет фиолетовое яблоко'
			$mass[11]='привет чёрный банан'
			$result = $str(@em.arr.search('$mass','зелён(ое|ый)'))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','[last]'))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','[past]'))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','',4,7))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','',3,8))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','[last]',3,8))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','',6))
			$result += $str(@em.arr.search('$mass','зелён(ое|ый)','[last]',6))
		})

	elseif $args[0]='em.gen_uuid':
		$result = $dyneval({
			#result = 1
			loop local i=0 while i<10 step i+=1:
			    #result = strcomp(@em.gen_uuid(), '[A-Fa-f0-9]{8}(\-[A-Fa-f0-9]{4}){3}\-[A-Fa-f0-9]{12}')
			end
			$result = $str(#result)
		})

	elseif $args[0]='em.str.head_tail':
		$result = $dyneval({
			local $text="Январь|Февраль|Март|Апрель|Май|Июнь|Июль|Август|Сентябрь|Октябрь|Ноябрь|Декабрь"

			$result = $str([
			    @em.str.head_tail($text),
			    @em.str.head_tail($text,'А'),
			    @em.str.head_tail($text,'Ав'),
			    @em.str.head_tail($text,'брь')
			])
		})

	elseif $args[0]='em.str.random':
		$result = $dyneval({
			$result = $str([
				strcomp(@em.str.random(), '.+'),
				strcomp(@em.str.random(16,'[inc][\d][\z][\я]'), '[0-9A-Za-zА-Еа-еЖ-Яж-яёЁ]{16}'),
				strcomp(@em.str.random(16), '.{16}'),
				strcomp(@em.str.random(16,'[inc][\d][\z][\я]','$ @ !'), '[0-9A-Za-zА-Еа-еЖ-Яж-яёЁ$ @!]{16}'),
				strcomp(@em.str.random(16,'24680','  ©'), '([ ©]|[^24680]){16}'),
				strcomp(@em.str.random(16,'2 4 6 8 0','  ©'), '([ ©]|[^24680]){16}')
			])
		})

	elseif $args[0]='em.str.thin':
		$result=$dyneval({
			$result = $str([
				@em.str.thin('профессура'),
				@em.str.thin('профессура',1,'|'),
				@em.str.thin('профессура',1,'|','[right]'),
				@em.str.thin('профессура',1,'|','[left]'),
				@em.str.thin('профессура',1,'|','[right][left]'),
				@em.str.thin('профессура',3,'|'),
				@em.str.thin('профессура',3,'|','[up]'),
				@em.str.thin('профессура',3,'|','[left]'),
				@em.str.thin('профессура',2,'|','[right]'),
				@em.str.thin('профессура',1,'||','[left] [right]')
			])
		})

	elseif $args[0]='em.zero':
		$result=$dyneval({
			$result = $str([
				@em.zero(13),
				@em.zero(13,'1'),
				@em.zero(13,'10'),
				@em.zero(13,'a'),
				@em.zero(3,'bla')
			])
		})

!@ --------------------------------------- Операции  текстовые -------------------------------------

!@ ------------------------------ Операции с шестнадцатеричными числами ----------------------------

	elseif $args[0]='em.col.add':
		$result = $dyneval({
			$result = $str([
				@em.col.add('ff0000','-44'),
				@em.col.add('000000','-44'),
				@em.col.add('dd0000','22'),
				@em.col.add('dd8822','-44'),
				@em.col.add('dd8822','44'),
				@em.col.add('dd882299','44')
			])
		})

	elseif $args[0]='em.col.in_rgb':
		$result = $dyneval({
			$result = $str([
				@em.col.in_rgb('ff0000'),
				@em.col.in_rgb('000000'),
				@em.col.in_rgb('dd0000'),
				@em.col.in_rgb('dd8822'),
				@em.col.in_rgb('ffmm00'),
				@em.col.in_rgb('-0000ff'),
				@em.col.in_rgb('238c9088')
			])
		})

	elseif $args[0]='em.col.inv':
		$result = $dyneval({
			$result = $str([
				@em.col.inv('000000'),
				@em.col.inv('ffffff'),
				@em.col.inv('238c90'),
				@em.col.inv('902b10'),
				@em.col.inv('c7c000'),
				@em.col.inv('07c701'),
				@em.col.inv('c7c00084'),
				@em.col.inv('07c7014d')
			])
		})

	elseif $args[0]='em.dec.in_col':
		$result = $dyneval({
			$result = $str([
				@em.dec.in_col(2147483647),
				@em.dec.in_col(214),
				@em.dec.in_col(255),
				@em.dec.in_col(-10),
				@em.dec.in_col(256),
				@em.dec.in_col(16)
			])
		})

		elseif $args[0]='em.hex.in_dec':
			$result = $dyneval({
				$result = $str([
					@em.hex.in_dec('ff'),
					@em.hex.in_dec('22'),
					@em.hex.in_dec('10'),
					@em.hex.in_dec('1'),
					@em.hex.in_dec('a'),
					@em.hex.in_dec('ffaa233'),
					@em.hex.in_dec('ffaa23'),
					@em.hex.in_dec('ffaa2'),
					@em.hex.in_dec('ffaa233451'),
					@em.hex.in_dec('ffaa23345'),
					@em.hex.in_dec('ffaa2334')
				])
			})

		
		elseif $args[0]='em.hex.add':
			$result = $dyneval({
				$result = $str([
					@em.hex.add('ffefa0','ff'),
					@em.hex.add('ff','ff'),
					@em.hex.add('100','ff'),
					@em.hex.add('fff','ff'),
					@em.hex.add('ff0','aaab76'),
					@em.hex.add('aaab76','cc'),
					@em.hex.add('ffeeff','a1'),
					@em.hex.add('f0','f'),
					@em.hex.add('ff','1'),
					@em.hex.add('ffe','1'),
					@em.hex.add('fef','1'),
					@em.hex.add('aaaaaa','cc')
				])
			})

		elseif $args[0]='em.dec.in_hex':
			$result = $dyneval({
				$result = $str([
					@em.dec.in_hex(2147483647),
					@em.dec.in_hex(214),
					@em.dec.in_hex(255),
					@em.dec.in_hex(10),
					@em.dec.in_hex(9),
					@em.dec.in_hex(2147483648)
				])
			})

!@ ------------------------------ Операции с шеснадцатеричными числами -----------------------------

!@ -------------------------------------- Операции с массивами -------------------------------------

	elseif $args[0]='em.arr.desort':
		$result = $dyneval({
			local old_mass, em_array, new_mass, %r
			unpackarr 'old_mass', [949, 913, 269, 901, 257, 561, 529, 293]
			@@em.arr.sort 'old_mass',0,'em_array'
			%r = [%arrpack('old_mass'), %arrpack('em_array')]
			@@em.arr.deSort 'old_mass','em_array','new_mass'
			$result = $str(%r & [%arrpack('new_mass')])
		})

	elseif $args[0]='em.arr.simpl':
		$result=$dyneval({
			local mass1, mass2, mass3
			unpackarr 'mass1', [455, 705, 967, 452, 829, 84, 983, 824]
			unpackarr 'mass2', [455, 705, 967, 452, 829, 84, 983, 824]
			unpackarr 'mass3', [983, 967, 829, 824, 705, 455, 452, 84]

			$result =$str([
				@em.arr.simpl('mass1','mass2'),
				@em.arr.simpl('mass1','mass3'),
				@em.arr.simpl('mass1','mass3','[simp]')
			])
		})

	elseif $args[0]='em.arr.sort':
		$result=$dyneval({
			local old_mass_n, old_mass_t, em_array, new_mass, mass, %r

			unpackarr 'old_mass_n', [157, 250, 709, 413, 532, 779, 730, 565]
			@@em.arr.sort('old_mass_n')
			%r[] = %arrpack('old_mass_n')

			unpackarr 'old_mass_n', [966, 812, 796, 304, 678, 118, 901, 132]
			@@em.arr.sort('old_mass_n', 0, 'em_array')
			%r[] = [%arrpack('old_mass_n'), %arrpack('em_array')]

			unpackarr 'old_mass_t', [
				[967, 'голова'], [629, 'плечи'],  [541, 'руки'],   [290, 'торс'],
				[852, 'бёдра'],  [334, 'голени'], [318, 'ступни'], [529, 'нишваа']
			] 
			@@em.arr.sort('old_mass_t',0,'em_array','new_mass')
			%r[] = [%arrpack('old_mass_t'), %arrpack('em_array'), %arrpack('new_mass')]

			unpackarr 'mass', ['88ff88','ff00ff','0ff0f8','ffffff','8888ff','fff8f8']
			@@em.arr.sort('mass', 1, 'em_array')
			%r[] = [%arrpack('mass'), %arrpack('em_array')]

			$result = $str(%arrpack('%r'))
		})

	elseif $args[0]='em.arr.print':
		$result=$dyneval({
			$result = ''
			local $a
			unpackarr '$a', [
				'нулевая ячейка','   первая ячейка   ',' вторая ячейка','',
				$str([1,2,3,5,6]),'   пятая ячейка','','седьмая ячейка'
			]
			local $trim_ = {
				result = args[1]
				if 0:
					elseif $args[0] = 'cell':
						args[21], args[22] = %args[4]
						$args[23] = $iif(instr('$#%',$mid($args[3],1,1)),$mid($args[3],1,1), $arrtype($args[3], args[5]))
						if $args[23] = '$': $args[2] = "'<<$replace($trim($args[2]), '''', '''''')>>'"
						if args[5] <> args[21]: result += @em.RN
						result += '<<$args[3]>>[<<args[5]>>] = <<$args[2]>>'
				end
			}
			local $trim_only_result_ = {
				result = args[1]
				if 0:
					elseif $args[0] = 'cell':
						args[21], args[22] = %args[4]
						$args[30], %args[6] = %args[6]
						if args[5] <> args[21]: result += $iif($args[30], $args[30], @em.RN)
						result += $trim($args[2])
					elseif $args[0] = 'footer':
						$args[30], $args[31] = %args[6]
						if $args[31] = 'with last': result += $args[30]
				end
			}

			$result =  @em.arr.print('$a')
			$result += @em.arr.print('$a','[only result]')
			$result += @em.arr.print('$a', ?, ?, $trim_)
			$result += @em.arr.print('$a', ?, [2,5], $trim_only_result_, ['|'])
			$result += @em.arr.print('$a', ?, [2,5], $trim_only_result_, ['|', 'with last'])
		})

	elseif $args[0]='em.fewarrs.print':
		$result=$dyneval({
			local a, b, c, d
			unpackarr '$a', [
				'нулевая ячейка', 'первая ячейка', 'вторая ячейка', '',
				'четвёртая'' ячейка', "пятая яче'йка", '', 'седьмая ячейка'
			]
			unpackarr '%b', [
				[0, 'zero'], ['first', 1, 0], [2, 'second', 2], ['3'],
				[3,5,6,'string',6], ['пятая ячейка'], ['6'], ['7']
			]
			local $callback_ = {
				result = args[1]
					if 0:
						elseif $args[0] = 'cell':
							$args[24] = $iif(instr('$#%',$mid($args[5],1,1)),$mid($args[5],1,1), $arrtype($args[5], args[3]))
							if $args[24] = '$': $args[4] = "'<<$replace($args[4], '''', '''''')>>'"
							if args[6] <> 0: result += '|'
							result += $args[4]
						elseif $args[0] = 'row-end':
							if args[3] < args[6]-1: result += '|...|'
					end
			}
			$result =  @em.fewArrs.print(['$a','%b'])
			$result += @em.fewArrs.print(['$a','%b'], '[range onscreen:3-6]')
			$result += @em.fewArrs.print(['$a','%b'],'[only result]')
			$result += @em.fewArrs.print(['$a','%b'],'[no table]')
			$result += @em.fewArrs.print(['$c','%d'], '[empty:EMPTY ARRAYS]')
			$result += @em.fewArrs.print(['$a','$b'],'[no table]')
			$result += @em.fewArrs.print(['$a','b'],'[range onscreen:3-6]',$callback_)
		})

	elseif $args[0]='em.arr.clear':
		$result=$dyneval({
			local i
			unpackarr 'i', [1, 2, 3, 1, 2, 3, 1, 2]
			@@em.arr.clear 'i', 2
			$result=$str(%arrpack('i'))
		})

	elseif $args[0]='em.arr.concatenate':
		$result=$dyneval({
			local old_mass, mass, arr_mass, em_result
			unpackarr 'old_mass', [967, 629, 541, 290, 852, 334, 318, 529 ]
			unpackarr 'mass', ['88ff88', 'ff00ff', '0ff0f8', 'ffffff', '8888ff', 'fff8f8']
			unpackarr 'arr_mass', ['голова', 'плечи', 'грудь', 'живот',
									'бёдра', 'колени', 'икры', 'ступни']

			@@em.arr.concatenate 'em_result', 'old_mass', 'mass', 'arr_mass'
			$result = $str(%arrpack('em_result'))
		})

	elseif $args[0]='em.arr.enumerate':
		$result = $dyneval({
			local mass1, mass2, em_array, mass3
			unpackarr 'mass1', [157, 250, 709, 413, 532, 779, 730, 565]
			unpackarr 'mass2', [голова:157, плечи:250, руки:709, крюки:413, 
								пояс:532, стопы:779, нишхваа:730, аад:565]
			@@em.arr.enumerate 'mass1', 'em_array'
			@@em.arr.enumerate 'mass2', 'mass3'
			$result = $str([%arrpack('em_array'), %arrpack('mass3')])
		})

	elseif $args[0]='em.arr.few_kill':
		$result=$dyneval({
			local mass1, em_array
			unpackarr 'mass1', [157, 250, 709, 413, 532, 779, 730, 565]
			@@em.arr.few_kill 'mass1', 0, 3, 6
			unpackarr 'mass2', [x:157, a:250, v:709, y:413, n:532, b:779, z:730, w:565]
			@@em.arr.few_kill 'mass2', 'x', 'y', 'z'
			set mass3[0,1], mass3[0,2], mass3[0,3], mass3[0,0] = 157, 250, 709, 413
			set mass3[1,0], mass3[1,1], mass3[1,2], mass3[1,3] = 532, 779, 730, 565
			@@em.arr.few_kill 'mass3', [0,1], [0,0], [1,2]
			$result = $str([%arrpack('mass1'), %arrpack('mass2'), %arrpack('mass3')])
		})

	elseif $args[0]='em.arr.fill':
		$result = $dyneval({
			local old_mass_n, %old_mass_t, $new_mass, %r
			unpackarr 'old_mass_n', [157, 250, 709, 413, 532, 779, 730, 565]
			@@em.arr.fill 'old_mass_n', [966, 812, 796, 304, 678, 118, 901, 132]
			%r[] = %arrpack('old_mass_n')

			@@em.arr.fill 'old_mass_n', [157, 250, 709, 413, 532, 779], arrsize('old_mass_n')
			%r[] = %arrpack('old_mass_n')
			
			unpackarr 'old_mass_t', [[967, 'голова'], [629, 'плечи'], [541, 'руки'], [290, 'торс']]
			@@em.arr.fill '%old_mass_t', [[852, 'бёдра'], [334, 'голени'], [318, 'ступни']], 7
			%r[] = %arrpack('old_mass_t')

			unpackarr '$new_mass', ['88ff88','ff00ff','0ff0f8']
			@@em.arr.fill '$new_mass', ['ffffff','8888ff','fff8f8'], 1
			%r[] = %arrpack('$new_mass')

			$result = $str(%arrpack('%r'))
		})

	elseif $args[0]='em.arr.fill_rand':
		$result = $dyneval({
			local mass1, mass2, mass3
			@@em.arr.fill_rand 'mass1', 8
			@@em.arr.fill_rand 'mass2', 6, [], 2
			@@em.arr.fill_rand 'mass3', 6, [2,9], 2

			$result =  $str(strcomp($str(%arrpack('mass1')), '\[(\d{1,4}, ){7}\d{1,4}\]'))
			$result += $str(strcomp($str(%arrpack('mass2')), '\[(\?, ){2}(\d{1,4}, ){5}\d{1,4}\]'))
			$result += $str(strcomp($str(%arrpack('mass3')), '\[(\?, ){2}([2-9], ){5}[2-9]\]'))
		})

	elseif $args[0]='em.arr.fill_strt':
		$result = $dyneval({
			local t, b, z, f
			@@em.arr.fill_strt 't',8
			@@em.arr.fill_strt 'b',8,[0,4]
			@@em.arr.fill_strt 'z',8,[2,0]
			@@em.arr.fill_strt 'f',8,[3,5],2

			$result = $str([%arrpack('t'), %arrpack('b'), %arrpack('z'), %arrpack('f')])
		})

	elseif $args[0]='em.arr.find':
		$result = $dyneval({
			local mass1, mass2
			unpackarr 'mass1', [574, 668, 413, 765, 478, 205, 701, 272]
			unpackarr 'mass2', [[3, 'd'], [4, 'e'], [1, 'b'], [2, 'c'], [8, 'j'],
								[5, 'f'], [0, 'a'], [6, 'g'], [7, 'h'], [9, 'k']]
			$result = $str([
				@em.arr.find('mass1', '[max]'),
				@em.arr.find('mass1', '[max]', [0, 2]),
				@em.arr.find('mass1', '[min]', [], [400, 600]),
				@em.arr.find('mass1', '[min]', [3, 6], [400, 600]),
				@em.arr.find('mass1', '[min]', [3, 6], [900, 1000]),
				@em.arr.find('mass2', '', [2, 6]),
				@em.arr.find('mass2', '', [0, 3])
			])
		})

	elseif $args[0]='em.arr.restand':
		$result = $dyneval({
			local mass1, mass2, mass3, mass4, em_array
			unpackarr 'mass1', ['голова', 'плечи', 'грудь', 'живот',
								'бёдра', 'колени', 'икры', 'ступни']
			unpackarr 'mass2', ['722', '136', '788', '177', '780', '97', '649', '75']
			unpackarr 'mass4', [-7, -6, -5, -4, -3, -2, -1, 0]
			@@em.arr.sort 'mass1', 0, 'em_array'
			@@em.arr.restand 'mass2', 'em_array', 'mass3'
			@@em.arr.restand 'mass4', 'em_array'

			$result = $str([%arrpack('mass1'), %arrpack('mass2'), %arrpack('mass3'),
							%arrpack('mass4'), %arrpack('em_array')])
		})

	elseif $args[0]='em.arr.summ':
		$result = $dyneval({
			local mass1, mass2, mass3
			unpackarr 'mass1', [967, 629, 541, 290, 852, 334, 318, 529]
			unpackarr 'mass2', ['голова', 'плечи', 'грудь', 'живот',
								'бёдра', 'колени', 'икры', 'ступни']
			unpackarr 'mass3', [[0, 'zero'], ['first', 1, 0], [2, 'second', 2], ['3'],
								[3,5,6,'string',6], ['пятая ячейка'], ['6'], ['7']]
			$result = $str([
				@em.arr.summ('mass1'),
				@em.arr.summ('$mass2'),
				@em.arr.summ('%mass3')
			])
		})

!@ -------------------------------------- Операции с массивами -------------------------------------

!@ ----------------------------------- Операции с целыми числами -----------------------------------

	elseif $args[0]='em.abs':
		$result = $dyneval({
			$result = $str([
				@em.abs(123, 456), @em.abs(456, 123), @em.abs(-123, -456), 
				@em.abs(123, 123), @em.abs(-123, 456), @em.abs(-456, 123)
			])
		})

	elseif $args[0]='em.digs':
		$result = $dyneval({
			$result = $str([
				@em.digs(36),
				@em.digs(360),
				@em.digs(366),
				@em.digs(9999),
				@em.digs(-45023)
			])
		})

	elseif $args[0]='em.even':
		$result = $dyneval({
			$result = $str([
				@em.even(549, 10, "[up]"),
				@em.even(549, 10, "[down]"),
				@em.even(549, 1000),
				@em.even(-5545, 12),
				@em.even(45599),
				@em.even(-45599)
			])
		})

	elseif $args[0]='em.exp':
		$result = $dyneval({
			$result = $str([
				@em.exp(6,6),
				@em.exp(4,2),
				@em.exp(4,3),
				@em.exp(4,4),
				@em.exp(250,2)
			])
		})

	elseif $args[0]='em.log':
		$result = $dyneval({
			$result = $str([
				@em.log(10),
				@em.log(100,2),
				@em.log(1000,5),
				@em.log(2345,5),
				@em.log(1013,13),
				@em.log(567)
			])
		})

	elseif $args[0]='em.random':
		$result = $dyneval({
			$result = 'true'
			local r
			loop local i=0 while i<10000 step i+=1:
				r = @em.random([10, 20], [30, 40], [50, 60])
				if no ((r >= 10 and r <= 20) or (r >= 30 and r <= 40) or (r >= 50 and r <= 60)):
					$result = 'false'
					jump 'break_em_random'
				end
			end
			:break_em_random
		})

!@ ----------------------------------- Операции с целыми числами -----------------------------------

!@ -------------------------------- Операции с координатной сеткой ---------------------------------

	elseif $args[0]='em.map.cell.get_coords':
		$result = $dyneval({
			$result = $str([
				@em.map.cell.get_coords(0,3+1),
				@em.map.cell.get_coords(10,3+1),
				@em.map.cell.get_coords(15,3+1),
				@em.map.cell.get_coords(26,4)
			])
		})

!@ -------------------------------- Операции с координатной сеткой ---------------------------------

!@ ---------------------------------------- Операции с HTML ----------------------------------------

	elseif $args[0]='em.html.clr_pref':
		$result = $dyneval({
			$result = @em.html.clr_pref("
				<table width=50% border=1>
			        <tr>
			            <td>первая ячейка первой строки</td>
			            <td> вторая ячейка первой строки</td>
			        </tr>
			        <tr>
			            <td>первая ячейка второй строки</td>
			            <td> вторая ячейка второй строки</td>
			        </tr>
			    </table>
    		")
		})

	elseif $args[0]='em.html.to_mnemonics':
		$result = $dyneval({
			$result = @em.html.to_mnemonics("<table width=50% border=1><tr><td>&первая ячейка первой строки</td><td>вторая ячейка первой строки</td></tr><tr><td>первая ячейка второй строки</td><td>вторая ячейка второй строки&</td></tr></table>")
		})

!@ ---------------------------------------- Операции с HTML ----------------------------------------

!@ -------------------------------------- Операции с кортежами -------------------------------------

	elseif $args[0]='em.str.to_tpl':
		$result = $dyneval({
			$result = $str(@em.str.to_tpl("[852, 'бёдра', [3, 5, 6, 'string', 6]]"))
		})

	elseif $args[0]='em.tpl.get':
		$result = $dyneval({
			$result = $str([
				@em.tpl.get([967, 629, 541, 290, 852, 334, 318, 529],  4),
				@em.tpl.get(['голова', 'плечи', 'грудь', 'живот',
								'бёдра', 'колени', 'икры', 'ступни'], 4),
				@em.tpl.get([[0, 'zero'], ['first', 1, 0], [2, 'second', 2], ['3'],
								[3,5,6,'string',6], ['пятая ячейка'], ['6'], ['7']], 4)
			])
		})

!@ -------------------------------------- Операции с кортежами -------------------------------------


end
--- em.autotest ---------------------------------
!@pp:endif
