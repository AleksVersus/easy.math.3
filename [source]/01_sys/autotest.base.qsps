QSP-Game База ожидаемых значений по каждому автотесту

!@ %0 - кортеж с именами тестируемых функций
!@ $1 - имя массива, в который возвращаем базу
# em.autotest.base
if $args[1] = '': msg 'em.autotest.base: не указано имя массива' & exit
local $comms_ = $str(%args[0])
alias %em_autotest_base_temp_array_ = $args[1]
!@ -------------- Вспомогательные функции --------------

	!@ em.deRGB
	if instr($comms_, "'em.dergb'") or $comms_ = '[]':
		%em_autotest_base_temp_array_[] = [
			name: 'em.dergb',
			expected: '[[255, 255, 0, 255], [0, 98, 98, 255], [240, 230, 140, 100], [240, 230, 140, 100], [240, 230, 140, 237]]'
		]
	end

	!@ em.str.get_word
	if instr($comms_, "'em.str.get_word'") or $comms_ = '[]':
		%em_autotest_base_temp_array_[] = [
			name: 'em.str.get_word',
			expected: 'ЯнварьФевральМайАвгустНоябрьДекабрьДекабрь'
		]
	end

	!@ em.str.in_regexp
	if instr($comms_, "'em.str.in_regexp'") or $comms_ = '[]':
		%em_autotest_base_temp_array_[] = [
			name: 'em.str.in_regexp',
			expected: '\(\[\\^\]\[\]\*\?\)\(\[\\^\]\[\]\+\?\)\(\[\\^><\]\*\?\)\(\[\\^><\]\+\?\)\(\[\\^\}\{\]\*\?\)\(\[\\^\}\{\]\+\?\)\(\[\\^\)\(\]\*\?\)\(\[\\^\)\(\]\+\?\)''\)\(\[\\s\\S\]\*\?\)\\1\(\:\|\=#\)\[\\S\]\+\(\:\|\=#\)\(\[\\S\]\+\)'
		]
	end

	!@ em.tag.get_cont
	if instr($comms_, "'em.tag.get_cont'") or $comms_ = '[]':
		%em_autotest_base_temp_array_[] = [
			name: 'em.tag.get_cont',
			expected: 'текст с пробеломстранный и непонятный текстп р о б е л ь н ы е и непробельные символыff8899многа букав'
		]
	end

	!@ em.tag.get_num
	if instr($comms_, "'em.tag.get_num'") <> 0 or $comms_ = '[]':
		%em_autotest_base_temp_array_[] = [
			name: 'em.tag.get_num',
			expected: "[текст с пробелом][68][непробельные_символы][ff8899][многа букав][][ff8899]"
		]
	end

