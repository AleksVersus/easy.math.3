!@ для arr.print и fewArrs.print: при выводе на экран табуляции могут быть заменены пробелами
!@ поэтому копирование текста с экрана копирует не тот же вывод, который в действительности
!@ дают функции. То же самое с пустыми строками. При копировании текста с экрана, пустые
!@ строки не копируются. Строить проверку на скопированной с экрана информации опасно.

!@ em.arr.print
if instr($comms_,"'em.arr.print'")<>0 or $comms_ = '[]':
	%em_autotest_base_temp_array_[] = [
		name: 'em.arr.print',
		expected: "$a[0] = 'нулевая ячейка'
$a[1] = '   первая ячейка   '
$a[2] = ' вторая ячейка'
$a[3] = ''
$a[4] = '[1, 2, 3, 5, 6]'
$a[5] = '   пятая ячейка'
$a[6] = ''
$a[7] = 'седьмая ячейка'нулевая ячейка
   первая ячейка   
 вторая ячейка

[1, 2, 3, 5, 6]
   пятая ячейка

седьмая ячейка$a[0] = 'нулевая ячейка'
$a[1] = 'первая ячейка'
$a[2] = 'вторая ячейка'
$a[3] = ''
$a[4] = '[1, 2, 3, 5, 6]'
$a[5] = 'пятая ячейка'
$a[6] = ''
$a[7] = 'седьмая ячейка'вторая ячейка||[1, 2, 3, 5, 6]|пятая ячейкавторая ячейка||[1, 2, 3, 5, 6]|пятая ячейка|"
	]
end

!@ em.fewarrs.print
if instr($comms_,"'em.fewarrs.print'")<>0 or $comms_ = '[]':
	%em_autotest_base_temp_array_[] = [
		name: 'em.fewarrs.print',
		expected: "<table border=1 cellpadding=5><tr><th>#</th><th>$a</th><th>%b</th></tr><tr><td>0</td><td>нулевая ячейка</td><td>[0, 'zero']</td></tr><tr><td>1</td><td>первая ячейка</td><td>['first', 1, 0]</td></tr><tr><td>2</td><td>вторая ячейка</td><td>[2, 'second', 2]</td></tr><tr><td>3</td><td>&nbsp;</td><td>['3']</td></tr><tr><td>4</td><td>четвёртая' ячейка</td><td>[3, 5, 6, 'string', 6]</td></tr><tr><td>5</td><td>пятая яче'йка</td><td>['пятая ячейка']</td></tr><tr><td>6</td><td>&nbsp;</td><td>['6']</td></tr><tr><td>7</td><td>седьмая ячейка</td><td>['7']</td></tr></table><table border=1 cellpadding=5><tr><th>#</th><th>$a</th><th>%b</th></tr><tr><td>3</td><td>&nbsp;</td><td>['3']</td></tr><tr><td>4</td><td>четвёртая' ячейка</td><td>[3, 5, 6, 'string', 6]</td></tr><tr><td>5</td><td>пятая яче'йка</td><td>['пятая ячейка']</td></tr><tr><td>6</td><td>&nbsp;</td><td>['6']</td></tr></table>нулевая ячейка	[0, 'zero']
первая ячейка	['first', 1, 0]
вторая ячейка	[2, 'second', 2]
	['3']
четвёртая' ячейка	[3, 5, 6, 'string', 6]
пятая яче'йка	['пятая ячейка']
	['6']
седьмая ячейка	['7']$a[0]='нулевая ячейка'	&	%b[0]=[0, 'zero']
$a[1]='первая ячейка'	&	%b[1]=['first', 1, 0]
$a[2]='вторая ячейка'	&	%b[2]=[2, 'second', 2]
$a[3]=''	&	%b[3]=['3']
$a[4]='четвёртая'' ячейка'	&	%b[4]=[3, 5, 6, 'string', 6]
$a[5]='пятая яче''йка'	&	%b[5]=['пятая ячейка']
$a[6]=''	&	%b[6]=['6']
$a[7]='седьмая ячейка'	&	%b[7]=['7']EMPTY ARRAYS$a[0]='нулевая ячейка'	&	$b[0]=''
$a[1]='первая ячейка'	&	$b[1]=''
$a[2]='вторая ячейка'	&	$b[2]=''
$a[3]=''	&	$b[3]=''
$a[4]='четвёртая'' ячейка'	&	$b[4]=''
$a[5]='пятая яче''йка'	&	$b[5]=''
$a[6]=''	&	$b[6]=''
$a[7]='седьмая ячейка'	&	$b[7]=''''|['3']|...|'четвёртая'' ячейка'|[3, 5, 6, 'string', 6]|...|'пятая яче''йка'|['пятая ячейка']|...|''|['6']"
	]
	end

