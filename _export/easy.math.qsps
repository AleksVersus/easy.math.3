			%em_arr_concatenate_temp_[args[24]] = (%em_arr_concatenate_temp_[args[24]] & arritem($args[args[22]], args[24]))
		end
	else:
		%em_arr_concatenate_temp_[args[24]] = [ arritem($args[1], args[24]), arritem($args[2], args[24]) ]
