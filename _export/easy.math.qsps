end
*pl "Start of Autotest." & wait 500
loop local i,size=0,arrsize('$functions') while i<size step i+=1:
	if loc($functions[i]):
		*pl "Function '<<$functions[i]>>' is exist."
		wait 500
		$res=@em.autotest($functions[i])
		if $res=$example[$functions[i]]:
			*pl "Autotest of '<<$functions[i]>>' completed. All Ok!"
			wait 500
		else
			*pl "Autotest Error. Dif Result:"
			usehtml = 1
			*pl "<table border=1 cellspacing=5><tr><td>Еxpected results:</td><td>Obtained results:</td></tr><tr><td><<@em.html.to_mnemonics($example[$functions[i]])>></td><td><<@em.html.to_mnemonics($res)>></td></tr></table>"
			if $args[1]='compile':
				local $f,$r
				loop local j,size=1,max(len($example[$functions[i]]),len($res)) while j<=size step j+=1:
					$f=$mid($example[$functions[i]],j,1)
					$r=$mid($res,j,1)
					if $f<>$r: *pl "[<<j>>]<<$f>>	<<$r>> "
				end
			end
			wait 500
		end
	else
		*pl "Function '<<$functions[i]>>' doesn't exist. Location not found."
		wait 500
	end
end
*pl "End of Autotest."
--- em.autotest.self ---------------------------------


# em.q
local l = len($str(args[0]))
if l <= 6:
	%result = [0, 0, args[0], 0, 0, 0]	
else:
	%result = [0, args[0]/1000000, args[0] mod 1000000, 0, 0, 0]
end
--- em.q ---------------------------------
# em.q.summ
local summ
summ[0], summ[1], summ[2], summ[3], summ[4], summ[5] = %args[0]
loop local j, add = 1, 0 while j < arrsize('%args') step j += 1:
	add[0], add[1], add[2], add[3], add[4], add[5] = %args[j]
	loop local i = 5 while i >= 0 step i -= 1:
		summ[i] += add[i]
		if len($str(summ[i])) > 6:
			summ[i-1], summ[i] = summ[i-1]+summ[i]/1000000, summ[i] mod 1000000
		end
	end
end
%result = [summ[0], summ[1], summ[2], summ[3], summ[4], summ[5]]
--- em.q.summ ---------------------------------


# em.deRGB
local red, green, blue, alpha
local zero = rgb(0,0,0,128)
local r, g, b, a = 1, 256, 256*256, 256*256*256
if args[0]>0:
	alpha=args[0]/a
	blue=(args[0] mod a)/b
	green=(args[0] mod a mod b)/g
	red=(args[0] mod a mod b mod g)/r
else
	args[0]-=zero
	alpha=args[0]/a+128
	blue=(args[0] mod a)/b
	green=(args[0] mod a mod b)/g
	red=(args[0] mod a mod b mod g)/r
end
%result = [red, green, blue, alpha]
--- em.deRGB ---------------------------------


# em.str.get_word
local $src_string_, pos_ = $args[0], args[1]
local $regexp_, $matches_
$regexp_ = '[^|]+'
scanstr '$matches_', $src_string_, $regexp_
if pos_ > arrsize('$matches_'): pos_ = arrsize('$matches_')
if pos_ = 0: pos_ = 1
$result = $matches_[pos_ - 1]
--- em.str.get_word ---------------------------------


# em.str.in_regexp
$result = $replace($args[0], '\', '\\')
$result = $replace($result, '|', '\|')
$result = $replace($result, '[', '\[')
$result = $replace($result, ']', '\]')
$result = $replace($result, '(', '\(')
$result = $replace($result, ')', '\)')
$result = $replace($result, '.', '\.')
$result = $replace($result, '^', '\^')
$result = $replace($result, ':', '\:')
$result = $replace($result, '{', '\{')
$result = $replace($result, '}', '\}')
$result = $replace($result, '*', '\*')
$result = $replace($result, '!', '\!')
$result = $replace($result, '$', '\$')
$result = $replace($result, '^', '\^')
$result = $replace($result, '-', '\-')
$result = $replace($result, '+', '\+')
$result = $replace($result, '=', '\=')
$result = $replace($result, ',', '\,')
$result = $replace($result, '?', '\?')
--- em.str.in_regexp ---------------------------------


# em.tag.get_cont
if ($args[1]='<!--!>' or $args[1]='<!>') and $strfind($args[0],'<!--([\s\S]+?)-->')<>'':
	$result = $strfind($args[0],'<!--([\s\S]+?)-->',1)
elseif $strfind($args[0],'\['+$args[1]+':([\s\S]+?):'+$args[1]+'\]')<>'':
	$result = $strfind($args[0],'\['+$args[1]+':([\s\S]+?):'+$args[1]+'\]',1)
elseif $strfind($args[0],'\('+$args[1]+':([\s\S]+?):'+$args[1]+'\)')<>'':
	$result = $strfind($args[0],'\('+$args[1]+':([\s\S]+?):'+$args[1]+'\)',1)
elseif $strfind($args[0],'\['+$args[1]+'\]([\s\S]+?)\[\/'+$args[1]+'\]')<>'':
	$result = $strfind($args[0],'\['+$args[1]+'\]([\s\S]+?)\[\/'+$args[1]+'\]?',1)
elseif $strfind($args[0],'<'+$args[1]+':([\s\S]+?):'+$args[1]+'>')<>'':
	$result = $strfind($args[0],'<'+$args[1]+':([\s\S]+?):'+$args[1]+'>',1)
elseif $strfind($args[0],'<'+$args[1]+'>([\s\S]+?)<\/'+$args[1]+'>')<>'':
	$result = $strfind($args[0],'<'+$args[1]+'>([\s\S]+?)<\/'+$args[1]+'>',1)
elseif $strfind($args[0],$args[1]+':([\s\S]+?):'+$args[1])<>'':
	$result = $strfind($args[0],$args[1]+':([\s\S]+?):'+$args[1],1)
end
--- em.tag.get_cont ---------------------------------


# em.tag.get_num
local it_hex, $res_num = 0, ''
if $mid($args[1],len($args[1])-1)='/h': $args[1]=$replace($args[1],'/h') & it_hex=1
if $strfind($args[0],'\['+$args[1]+':'+'([^][]*?)'+'\]')<>'':
	$res_num = $strfind($args[0],'\['+$args[1]+':'+'([^][]+?)'+'\]',1)
elseif $strfind($args[0],'<'+$args[1]+':'+'([^><]*?)'+'>')<>'':
	$res_num = $strfind($args[0],'<'+$args[1]+':'+'([^><]+?)'+'>',1)
elseif $strfind($args[0],'\{'+$args[1]+':'+'([^}{]*?)'+'\}')<>'':
	$res_num = $strfind($args[0],'\{'+$args[1]+':'+'([^}{]+?)'+'\}',1)
elseif $strfind($args[0],'\('+$args[1]+':'+'([^)(]*?)'+'\)')<>'':
	$res_num = $strfind($args[0],'\('+$args[1]+':'+'([^)(]+?)'+'\)',1)
elseif $strfind($args[0],$args[1]+'=("|'+"')([\s\S]*?)\1")<>'':
	$res_num = $strfind($args[0],$args[1]+'=("|'+"')([\s\S]*?)\1",2)
elseif $strfind($args[0],$args[1]+'(:|=#)[\S]+')<>'':
	$res_num = $strfind($args[0],$args[1]+'(:|=#)([\S]+)',2)
end
if it_hex and $strfind($res_num,'^([0-9A-Fa-f\-]+)([\S]*)$')='':
	killvar '$result'
	exit
elseif it_hex:
	$res_num = $strfind($res_num,'^([0-9A-Fa-f\-]+)([\S]*)$',1)
end
$result=$res_num
--- em.tag.get_num ---------------------------------


# em.sqrt
local $res_
if $args[0]='': $args[0]=$str(args[0])
if $args[0]='0': $result = '0' & exit
if args[1] = 0: args[1] = 100
if $args[2]='':
	$args[2]=$dyneval({
		local $int_	& !@ целая часть числа
		if instr($args[0],'.')<>0: $int_=$mid($args[0],1,instr($args[0],'.')-1) else $int_=$args[0]
		if len($int_)>10 or (len($int_)=10 and $mid($int_,1,1)='2'): $result='46340' & exit
		if (len($int_)=10 and $mid($int_,1,1)='1') or (len($int_)=9 and $mid($int_,1,1)='9'): $result='31622' & exit
		if (len($int_)=9 and $mid($int_,1,1)='1') or (len($int_)=8 and $mid($int_,1,1)='9'): $result='10000' & exit
		if (len($int_)=8 and $mid($int_,1,1)='1') or (len($int_)=7 and $mid($int_,1,1)='9'): $result='3162' & exit
		if (len($int_)=7 and $mid($int_,1,1)='1') or (len($int_)=6 and $mid($int_,1,1)='9'): $result='1000' & exit
		if (len($int_)=6 and $mid($int_,1,1)='1') or (len($int_)=5 and $mid($int_,1,1)='9'): $result='316' & exit
		if (len($int_)=5 and $mid($int_,1,1)='1') or (len($int_)=4 and $mid($int_,1,1)='9'): $result='100' & exit
		if (len($int_)=4 and $mid($int_,1,1)='8'): $result='90' & exit
		if (len($int_)=4 and $mid($int_,1,1)='7'): $result='84' & exit
		if (len($int_)=4 and $mid($int_,1,1)='6'): $result='78' & exit
		if (len($int_)=4 and $mid($int_,1,1)='5'): $result='71' & exit
		if (len($int_)=4 and $mid($int_,1,1)='4'): $result='64' & exit
		if (len($int_)=4 and $mid($int_,1,1)='3'): $result='55' & exit
		if (len($int_)=4 and $mid($int_,1,1)='2'): $result='45' & exit
		if (len($int_)=4 and $mid($int_,1,1)='1'): $result='32' & exit
		if len($int_)=3:
			local i=val($int_)
			if i>960: $result='32' & exit
			if i>900: $result='31' & exit
			if i>841: $result='30' & exit
			if i>784: $result='29' & exit
			if i>729: $result='28' & exit
			if i>676: $result='27' & exit
			if i>625: $result='26' & exit
			if i>576: $result='25' & exit
			if i>529: $result='24' & exit
			if i>484: $result='23' & exit
			if i>441: $result='22' & exit
			if i>400: $result='21' & exit
			if i>361: $result='20' & exit
			if i>324: $result='19' & exit
			if i>289: $result='18' & exit
			if i>256: $result='17' & exit
			if i>225: $result='16' & exit
			if i>196: $result='15' & exit
			if i>169: $result='14' & exit
			if i>144: $result='13' & exit
			if i>121: $result='12' & exit
			if i>100: $result='11' & exit
			if i>81: $result='10' & exit
			if i>64: $result='9' & exit
			if i>49: $result='8' & exit
			if i>36: $result='7' & exit
			if i>25: $result='6' & exit
			if i>16: $result='5' & exit
			if i>9: $result='4' & exit
			if i>4: $result='3' & exit
			if i>1: $result='2' & exit
			if i>0: $result='1' & exit
		end
		$result='1'

	}, $args[0])
end
loop local run=1 while run:
	$res_ = @em.div(@em.add($args[2], @em.div($args[0],$args[2],args[1])), '2', args[1])
	if $res_<>$args[2]:
		$args[2]=$res_
	else
		run=0
		$result=$res_
		exit
	end
end
--- em.sqrt ---------------------------------


# em.add
local $int_, $fract_, $minus_, int_len_, fract_len_, $nines_
local $number_, $summ_
loop local i,b,size_=0,-1,arrsize('args') while i<size_ step i+=1:
	if $args[i]='' and args[i]<>0:
		$args[i]=$str(args[i])
	end
	if $args[i]<>'' and $strfind($args[i],'^0+(\.0+)?$')='':
		b+=1	
		if instr($args[i],'-')=1:
			$minus_[b]='-'
			$args[i]=$mid($args[i],2)
		else
			$minus_[b]=''
			$args[i]=$args[i]
		end
		if instr($args[i],'.')<>0:
			$int_[b]=$mid($args[i],1,instr($args[i],'.')-1)
			$fract_[b]=$mid($args[i],instr($args[i],'.')+1)
		else
			$int_[b]=$args[i]
			$fract_[b]='0'
		end
		if len($int_[b])>int_len_: int_len_=len($int_[b])
		if len($fract_[b])>fract_len_: fract_len_=len($fract_[b])
	end
end
int_len_+=2
fract_len_+=2
$nines_=@em.zero(int_len_+fract_len_,'9')
loop local i,b=0,arrsize('$int_') while i<b step i+=1:
	$number_[i]=@em.zero(int_len_-len($int_[i]))+$int_[i]+$fract_[i]+@em.zero(fract_len_-len($fract_[i]))
	if $minus_[i]='-':
		$number_[i]=@em.byte.dev($nines_,$number_[i])
	end
end
$summ_=@em.zero(int_len_+fract_len_)
loop local i,b=0,arrsize('$int_') while i<b step i+=1:
	$summ_=@em.byte.add($summ_,$number_[i])
end
if instr($summ_,'9')=1:
	$summ_=@em.byte.dev($nines_,$summ_)
	$minus_='-'
else
	$summ_=$summ_
	$minus_=''
end
$result=@em.dz($minus_+$mid($summ_,1,int_len_)+"."+$mid($summ_,int_len_+1))
--- em.add ---------------------------------


# em.div
local minus, $int, $fract, $divident, $divisor, $res, $approx, digit, $subtract
$args[0]=@em.dz($args[0],1)
$args[1]=@em.dz($args[1],1)
if args[2]<1: args[2]=1000
if instr($args[0],'-')=1: $args[0]=$mid($args[0],2) & minus=1-minus
if instr($args[1],'-')=1: $args[1]=$mid($args[1],2) & minus=1-minus
if minus=1: $minus='-' else $minus=''
if instr($args[0],'.')<>0:
	$int[0]=$mid($args[0],1,instr($args[0],'.')-1)
	$fract[0]=$mid($args[0],instr($args[0],'.')+1)
else:
	$int[0]=$args[0]
	$fract[0]=''
end
fract_len[0]=len($fract[0])
if instr($args[1],'.')<>0:
	$int[1]=$mid($args[1],1,instr($args[1],'.')-1)
	$fract[1]=$mid($args[1],instr($args[1],'.')+1)
else:
	$int[1]=$args[1]
	$fract[1]=''
end
fract_len[1]=len($fract[1])
if fract_len[1]>fract_len[0]:
	$fract[0]+=@em.zero(fract_len[1]-fract_len[0])
else
	$fract[1]+=@em.zero(fract_len[0]-fract_len[1])
end
$divident=$int[0]+$fract[0]
$divisor=$int[1]+$fract[1]
$res='0'
$approx=$mid($divident,1,len($divisor))
$divident=$mid($divident,len($divisor)+1)
digit=0
loop local i=args[2] while i>0:
	$subtract=@em.byte.dev('0'+$approx,'0'+$divisor)
	if instr($subtract,'9')=1:
		$res+=$str(digit)
		digit=0
		if len($divident)>0:
			$approx+=$mid($divident,1,1)
			$divident=$mid($divident,2)
		else
			if instr($res,'.')=0: $res+='.'
			$approx+='0'
		end
		if instr($res,'.')<>0: i/=10
	else
		digit+=1	
		$approx=$mid($subtract,2)
	end
end
$result=$minus+@em.dz($res)
--- em.div ---------------------------------


# em.mult
local minus, dot_pos
local fract_len = 0
loop local i,size=0,arrsize('args') while i<size step i+=1:
	if len($args[i])=0:
		$args[i]=$str(args[i])
	end
	if $args[i]='0': $result='0' & exit	
	if instr($args[i],'-')=1:
		$args[i]=$mid($args[i],2)
		minus=1-minus	
	end
	if instr($args[i],'.')<>0:
		dot_pos=instr($args[i],'.')
		fract_len+=len($args[i])-dot_pos	
		$args[i]=$replace($args[i],'.')
	end
end
local $multiply, first_multiplier, second_multiplier, stack
$multiply['result']=$args[0]
loop local i,size=1,arrsize('args') while i<size step i+=1:
	second_multiplier['digit']=len($args[i])
	$multiply['last']=''
	loop while second_multiplier['digit']>0 step second_multiplier['digit']-=1:
		second_multiplier['value']=val($mid($args[i],second_multiplier['digit'],1))
		first_multiplier['digit']=len($multiply['result'])
		$multiply['next']=''
		stack=0
		loop while first_multiplier['digit']>0 step first_multiplier['digit']-=1:
			first_multiplier['value']=val($mid($multiply['result'],first_multiplier['digit'],1))
			multiply['itteration']=first_multiplier['value']*second_multiplier['value']+stack
			multiply['digit']=(multiply['itteration'] mod 10)
			stack=multiply['itteration']/10
			$multiply['next']=$str(multiply['digit'])+$multiply['next']
		end
		if stack>0: $multiply['next']=$str(stack)+$multiply['next']
		$multiply['next']+=@em.zero(len($args[i])-second_multiplier['digit'])
		$multiply['last']=@em.byte.add($multiply['last'],$multiply['next'])
	end
	$multiply['result']=$multiply['last']
end
if minus=1: $minus='-' else $minus=''
local $res
$res['fract']=$mid($multiply['result'],len($multiply['result'])-fract_len+1)
$res['int']=$mid($multiply['result'],1,len($multiply['result'])-fract_len)
if $res['fract']<>'':
	$result=$minus+@em.dz($res['int']+'.'+$res['fract'])
else
	$result=$minus+@em.dz($res['int'])
end
--- em.mult ---------------------------------


# em.round
local $minus, $float, $digits, int_len, dot_pos, dig
if instr($args[0],'-')=1:
	$args[0]=$mid($args[0],2)
	$minus='-'
else
	$args[0]=$args[0]
	$minus=''
end
if args[1]<>0: $args[1]=$str(args[1])
if $args[1]='' or $args[1]='0': $args[1]='1'
if instr($args[0],'.')=0: $args[0]+='.0'
if instr($args[1],'.')=0: $args[1]+='.0'
$result=$args[0]
if strcomp($args[1],'(10*?\.0+)|(0.0*1)')=0: exit
$float['int']=$mid($args[0],1,instr($args[0],'.')-1)
$float['fract']=$mid($args[0],instr($args[0],'.')+1)
$digits['int']=$mid($args[1],1,instr($args[1],'.')-1)
$digits['fract']=$mid($args[1],instr($args[1],'.')+1)
if len($float['int'])>len($digits['int']):
	int_len=len($float['int'])-len($digits['int'])
	$digits['int']=@em.zero(int_len+1)+$digits['int']
	$float['int']='0'+$float['int']
else
	int_len=len($digits['int'])-len($float['int'])
	$float['int']=@em.zero(int_len+1)+$float['int']
	$digits['int']='0'+$digits['int']
end
if len($float['fract'])>len($digits['fract']):
	int_len=len($float['fract'])-len($digits['fract'])
	$digits['fract']+=@em.zero(int_len+1)
	$float['fract']+='0'
else
	int_len=len($digits['fract'])-len($float['fract'])
	$float['fract']+=@em.zero(int_len+1)
	$digits['fract']+='0'
end
dot_pos=len($float['int'])
$float['number']=$float['int']+$float['fract']
$digits['number']=$digits['int']+$digits['fract']
dig['after_pos']=instr($digits['number'],'1')+1	
if instr($args[2],'[up]')<>0:
	dig['after_value']=9
elseif instr($args[2],'[down]')<>0:
	dig['after_value']=0
else:
	dig['after_value']=val($mid($float['number'],dig['after_pos'],1))
end
if dig['after_value']<5: dig['next_value']=0 else dig['next_value']=1	
$float['number']=$mid($float['number'],1,dig['after_pos']-1)+'0'+@em.zero(len($digits['number'])-dig['after_pos'])
loop local dig_10, summ = 1,1 while dig['next_value']=1:
	dig_10=val($mid($float['number'],dig['after_pos']-1,1))
	summ=dig_10+dig['next_value']
	dig['next_value']=summ/10
	summ=summ mod 10
	$float['number']=$mid($float['number'],1,dig['after_pos']-2)+$str(summ)+$mid($float['number'],dig['after_pos'])
	dig['after_pos']-=1
end
$result=@em.dz($minus+$mid($float['number'],1,dot_pos)+'.'+$mid($float['number'],dot_pos+1))
--- em.round ---------------------------------


# em.simpl
local $float, $digits, $minus, $int, int_len, $fract
$float[0]=@em.dz($args[0],1)
$float[1]=@em.dz($args[1],1)
if instr($float[0],'.')=0: $float[0]+='.0'
if instr($float[1],'.')=0: $float[1]+='.0'
if $float[0]=$float[1]:
	$result=@em.dz($float[0])
	exit
else
	if instr($float[0],'-')=1:
		$digits[0]=$mid($float[0],2)
		$minus[0]='-'
	else
		$digits[0]=$float[0]
		$minus[0]=''
	end
	if instr($float[1],'-')=1:
		$digits[1]=$mid($float[1],2)
		$minus[1]='-'
	else
		$digits[1]=$float[1]
		$minus[1]=''
	end
	if $minus[0]='-' and $minus[1]<>'-':
		$result=@em.dz($float[1])
		exit
	elseif $minus[1]='-' and $minus[0]<>'-':
		$result=@em.dz($float[0])
		exit
	else
		$int[0]=$mid($digits[0],1,instr($digits[0],'.')-1)
		$int_len[0]=len($int[0])
		$int[1]=$mid($digits[1],1,instr($digits[1],'.')-1)
		$int_len[1]=len($int[1])
		if $int_len[0]>$int_len[1]:
			$int[1]=@em.zero($int_len[0]-$int_len[1])+$int[1]
		elseif $int_len[0]<$int_len[1]:
			$int[0]=@em.zero($int_len[1]-$int_len[0])+$int[0]
		end
		if $int[1]=$int[0]:
			$fract[0]=$mid($digits[0],instr($digits[0],'.')+1)
			$fract[1]=$mid($digits[1],instr($digits[1],'.')+1)
			if $max($fract[1],$fract[0])=$fract[1]:
				jump 'second'
			elseif $max($fract[1],$fract[0])=$fract[0]:
				jump 'first'
			end
		elseif $max($int[1],$int[0])=$int[1]:
			:second
			if $minus[1]='-':
				$result=@em.dz($float[0])
				exit
			else
				$result=@em.dz($float[1])
				exit
			end
		elseif $max($int[1],$int[0])=$int[0]:
			:first
			if $minus[1]='-':
				$result=@em.dz($float[1])
				exit
			else
				$result=@em.dz($float[0])
				exit
			end
		end
	end
end
$result=@em.dz($result)
--- em.simpl ---------------------------------


# em.indiv
local $minus, $res_indiv = '', ''
if (args[0]<0 and args[1]>0) or (args[0]>0 and args[1]<0): $minus='-'
if args[0]<0: args[0]=-args[0]
if args[1]<0: args[1]=-args[1]
if args[1]=0: args[1]=100	
if args[2]=0: args[2]=1000000000	
args[2]=len($str(args[2]))
loop local i,div,rod=0,0,0 while i<args[2] step i+=1:
	div=args[0]/args[1]
	rod=args[0] mod args[1]
	if i=1: $res_indiv+='.'
	$res_indiv+=$str(div)
	args[0]=rod*10	
end
$result=$minus+@em.dz($res_indiv)
--- em.indiv ---------------------------------


# em.divdigs
local dot_in_str, div							
dot_in_str=instr($args[0],'.')
if dot_in_str=0: result=1 & exit				
result=1
loop local div=len($mid($args[0],dot_in_str+1)) while div>0 step div-=1:
	result*=10
end
--- em.divdigs ---------------------------------


# em.dz
local $minus, dot, $start_part, $end_part, zero_num, $no_zeros	
if instr($args[0],'-')=1:
	$args[0]=$mid($args[0],2)
	$minus='-'
end
if args[1]<1:
	args[1]=1
else:
		args[1] = dyneval({
			loop result = 1 while no (args[0]/result < 10): result *= 10
		}, args[1])
end
if no instr($args[0], '.'):
	$args[0] += '.0'
end
dot=instr($args[0],'.')
$start_part=$mid($args[0],1,dot-1)
$end_part=$mid($args[0],dot+1)
zero_num=len($str(args[1]))-1	
$no_zeros=$strfind($end_part,'(\d*?)(0*)$',1)
if $no_zeros='':
	$end_part=''
elseif len($no_zeros)>=zero_num:
	$end_part=$no_zeros	
else
	$end_part=$mid($end_part,1,zero_num)
end
$start_part=$strfind($start_part,'(0*)(\d*)$',2)
if $start_part='': $start_part='0'
! @ если дробная часть не отсеклась, возвращаем число с точкой, иначе - без
if $end_part<>'':
	$result=$minus+$start_part+'.'+$end_part
elseif $start_part<>0:
	$result=$minus+$start_part
else
	$result='0'
end
--- em.dz ---------------------------------


# em.undiv
local $zero_num, dot_in_str, $end_part, $start_part	
if (args[1]<>0) and (args[1] mod 10 <> 0):
		if args[1]<0: args[1]=-args[1]
		local base_10=1 
		loop while no (args[1]/base_10<10):
			base_10*=10
		end
		args[1]=base_10
end
if isnum($args[0])<>0 and args[1]<>0:
	result=val($args[0])*args[1]
	exit
elseif isnum($args[0])<>0 and args[1]=0:
	result=val($args[0])
else
	$zero_num=$mid($str(args[1]),2)
	if $zero_num='': result=val($replace($args[0],'.')) & exit
	dot_in_str=instr($args[0],'.')
	$end_part=$mid($args[0],dot_in_str+1)
	$start_part=$mid($args[0],1,dot_in_str-1)
	if len($end_part)>=len($zero_num):
		result=val($start_part+$mid($end_part,1,len($zero_num)))
	else
		result=val($start_part+$end_part+$mid($zero_num,1,len($zero_num)-len($end_part)))
	end
end
--- em.undiv ---------------------------------


# em.byte.add
if $args[0]='': $args[0]=$str(args[0]) else $args[0] = $args[0]
if $args[1]='': $args[1]=$str(args[1]) else $args[1] = $args[1]
if no (strcomp($args[0], '\d+') and strcomp($args[1], '\d+')): $result = '[not a number]' & exit
local $x, $y = $args[0], $args[1]
local max_len_ = max(len($x), len($y))
local digital_ = iif(max_len_ mod 9 = 0, max_len_, (max_len_ / 9 + 1) * 9)
local $sum_, overflow_byte_
loop local run_ = 1 while run_:
	$x = @em.zero(digital_ - len($x)) + $x
	$y = @em.zero(digital_ - len($y)) + $y
	$sum_, overflow_byte_ = '', 0
	loop local i = digital_ while i > 0 step i -= 9:
		$sum_['9'] = $str(val($mid($x, i-9+1, 9)) + val($mid($y, i-9+1, 9)) + overflow_byte_)
		if len($sum_['9'])>9:
			overflow_byte_ = val($mid($sum_['9'], 1, 1))
			$sum_['9'] = $mid($sum_['9'], 2)
		else:
			overflow_byte_ = 0
		end
		$sum_ = $sum_['9'] + $sum_
	end
	if overflow_byte_ > 0:
		$x = $sum_	
		$y = @em.zero(digital_ - len($str(overflow_byte_))) + $str(overflow_byte_)
	elseif val($mid($sum_, 1, len($sum_) - max_len_)) > 0:
		$x = $mid($sum_, len($sum_) - max_len_ + 1)
		$y = $mid($sum_, 1, len($sum_) - max_len_)
	else:
		run_ = 0
	end
end
$result = @em.zero(max_len_ - len($sum_)) + $sum_
--- em.byte.add ---------------------------------


# em.byte.dev
local max_len, $term
if $args[0]='': $args[0]=$str(args[0]) else $args[0] = $args[0]
if $args[1]='': $args[1]=$str(args[1]) else $args[1] = $args[1]
max_len=max(len($args[0]),len($args[1]))
$term[0]=@em.zero(max_len-len($args[0]))+$args[0]
$term[1]=@em.zero(max_len-len($args[1]))+$args[1]
loop local last_byte,run=0,1 while run:
	$result=''
	last_byte = 0	
	loop local i,res_byte=max_len,0 while i>0 step i-=1:
		res_byte=val($mid($term[0],i,1))-val($mid($term[1],i,1))+last_byte
		if res_byte<0:
			res_byte=10+res_byte
			last_byte=-1
		else
			last_byte=0
		end
		$result=$str(res_byte)+$result
	end
	if last_byte=-1:
		$term[0]=$result
		$term[1]=@em.zero(max_len-1)+'1'
	else
		run=0
	end
end
--- em.byte.dev ---------------------------------


# em.arr.search
if $args[0] = '': msg 'em.str.in_arr: Wrong array name → <<$args[0]>>' & exit
if instr($args[0], '$') <> 1: msg 'em.str.in_arr: type prefix ''$'' not specified →  <<$args[0]>>' & exit
local em_arr_search_temp_array_
result = -1 
$args[2] = $lcase($args[2])
if args[4] < 1: args[4] = arrsize($args[0])-1	
copyarr 'em_arr_search_temp_array_', $args[0], args[3], args[4] - args[3] + 1
local pos_
if instr($args[2], '[first]') <> 0 or $args[2] = '':
	result = arrcomp('em_arr_search_temp_array_', '[\s\S]*' + $args[1] + '[\s\S]*')
elseif instr($args[2], '[last]') <> 0:
	loop local i, run_ = args[3], 1 while run_:
		pos_ = arrcomp('em_arr_search_temp_array_', '[\s\S]*' + $args[1] + '[\s\S]*', i)
		if pos_ = -1: jump 'break'
		result = pos_	
		i = result + 1	
	end
end
:break
if result <> -1: result += args[3]
--- em.arr.search


# em.gen_uuid
local $symbols_ = '0123456789abcdef'
$result = ''
loop local i = 0 while i < 36 step i += 1:
	if instr('[8][13][18][23]', '[<<i>>]'):
		$result += '-'
	else:
		$result += $mid($symbols_, rand(1,16), 1)
	end
end
--- em.gen_uuid ---------------------------------


# em.str.head_tail
if $args[1] = '': $args[1] = '|'
local i = instr($args[0], $args[1])
%result = [$mid($args[0], 1, i-1), $mid($args[0], i+len($args[1]))]
--- em.str.head_tail


# em.str.random
if args[0]=0: args[0]=rand(1,8)
$result = ''
local $symbols_, $new_symbols_ = '', ''
if $strfind($args[1],'(?i)\[inc(lude)?\]')<>'':
	$args[1]=$lcase($args[1])
	if instr($args[1],'[\all]')<>0 or instr($args[1],'[\d]')<>0: $symbols_+='1234567890'
	if instr($args[1],'[\all]')<>0 or instr($args[1],'[\h]')<>0: $symbols_+='1234567890abcdef'
	if instr($args[1],'[\all]')<>0 or instr($args[1],'[\s]')<>0: $symbols_+='	 '
	if instr($args[1],'[\all]')<>0 or instr($args[1],'[\w]')<>0:
		$symbols_+='QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm'
		$symbols_+='ЁЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮёйцукенгшщзхъфывапролджэячсмитьбю'
		$symbols_+='1234567890_'
	end
	if instr($args[1],'[\all]')<>0 or instr($args[1],'[\я]')<>0:
		$symbols_+='ЁЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮёйцукенгшщзхъфывапролджэячсмитьбю'
	end
	if instr($args[1],'[\all]')<>0 or instr($args[1],'[\z]')<>0:
		$symbols_+='QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm'
	end
	if instr($args[1],'[ucase]')<>0: $symbols_=$ucase($symbols_)
	if instr($args[1],'[lcase]')<>0: $symbols_=$lcase($symbols_)
	$args[1] = ''
elseif $strfind($args[1],'(?i)\[only this\]')<>'' or $strfind($args[1],'(?i)\[ot\]')<>'':
	$args[1] = ''
else
	$symbols_='QWERTYUIOP{}ASDFGHJKL:"ZXCVBNM<>?1234567890'
	$symbols_+="!@#$%^&*()_+-=`~qwertyuiop[]asdfghjkl;'zxcvbnm,./\|№"
	$symbols_+="ёйцукенгшщзхъфывапролджэячсмитьбюЁЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ"
end
loop local $temp while len($symbols_)>0:
	$temp=$mid($symbols_,1,1)
	if instr($args[1],$temp)=0:
		$new_symbols_+=$temp	
	end
	$symbols_ = $replace($symbols_,$temp)
end
$symbols_=$new_symbols_
if $args[2]<>'': $symbols_+=$args[2]
loop while args[0]>0 step args[0]-=1:
	$result += ($mid($symbols_,rand(1,len($symbols_)),1))
end
--- em.str.random ---------------------------------


# em.str.slice
local $string_, start_, end_ = $args[0], args[1], args[2]
if start_ = 0: start_ = 2
if end_ = 0: end_ = -2
if start_ < 0: start_ = len($string_) + 1 + start_
if end_ < 0: end_ = len($string_) + 1 + end_
if start_ < 0: end_ += start_
if start_ > len($string_) or end_ < 0: $result = '' & exit
$result = $mid($string_, start_, end_ - start_ + 1)
--- em.str.slice ---------------------------------


# em.str.thin
$result = ''
local $string_, spacing_, $delimiter_, $mode_ = $args[0], args[1], $args[2], $args[3]
if spacing_ < 1: spacing_ = 1	
if $delimiter_ = '': $delimiter_ = ' '
$mode_ = $lcase($mode_)
local $res_, len_, mod_
len_ = len($string_)
mod_ = len_ mod spacing_
if instr($mode_,'[up]') <> 0:
	if mod_ > 0: $string_ = $mid($string_, 1, spacing_ - mod_) + $string_
	scanstr '$res_', $string_, '[\s\S]{<<spacing_>>}'
	if mod_ > 0: $res_[0] = $mid($res_[0], spacing_)
else:
	if mod_ > 0: $string_ += $mid($string_, 1, spacing_ - mod_)
	scanstr '$res_', $string_, '[\s\S]{<<spacing_>>}'
	if mod_ > 0: $res_[arrsize('$res_')-1] = $mid($res_[], 1, mod_)
end
loop while arrsize('$res_'):
	if len($result) or instr($mode_, '[left]'):
		$result += $delimiter_ + $res_[0]
	else:
		$result += $res_[0]
	end
	killvar '$res_', 0
end
if instr($mode_,'[right]')<>0: $result += $delimiter_	
--- em.str.thin ---------------------------------


# em.str.widetrim
$args[1] = $lcase($args[1])
local $em_str_widetrim_temp_array_, strip_it_
scanstr '$em_str_widetrim_temp_array_', $args[0], '.+'
loop while arrsize('$em_str_widetrim_temp_array_')>0 and ($em_str_widetrim_temp_array_[0]='' or strcomp($em_str_widetrim_temp_array_[0],'[\s\n\r\t]+')<>0):
	killvar '$em_str_widetrim_temp_array_',0
end
loop while arrsize('$em_str_widetrim_temp_array_')>0 and ($em_str_widetrim_temp_array_[]='' or strcomp($em_str_widetrim_temp_array_[],'[\s\n\r\t]+')<>0):
	killvar '$em_str_widetrim_temp_array_', arrsize('$em_str_widetrim_temp_array_')-1
end
if instr($args[1],'[strip]')<>0: strip_it_ = 1	
$result=""
loop while arrsize('$em_str_widetrim_temp_array_')>0:
	if strip_it_: $em_str_widetrim_temp_array_[0] = $trim($em_str_widetrim_temp_array_[0])
	$result += $em_str_widetrim_temp_array_[0]
	if arrsize('$em_str_widetrim_temp_array_')>1: $result += @em.RN
	killvar '$em_str_widetrim_temp_array_',0
end
$result = $mid($result,1,len($result)-1)
--- em.str.widetrim ---------------------------------


# em.zero
if $args[1]='': $args[1]='0'
if $args[1]='0' and args[0]<=32:
	$result = $mid('00000000000000000000000000000000', 1, args[0])
else:
	loop while args[0]>0 step args[0]-=1: $result+=$args[1]
end
--- em.zero ---------------------------------


# em.col.add
local $r = '[A-Fa-f0-9]'
if no (strcomp($args[0], $r+'{6}') or strcomp($args[0], $r+'{8}')): $result = $args[0] & exit
local red_,green_,blue_,minus_,$alpha_,add_
minus_, $args[1] = %iif(instr($args[1],'-')=1, [-1, $mid($args[1],2)], [1, $args[1]])
add_ = minus_ * @em.hex.in_dec($args[1])
red_	= @em.hex.in_dec($mid($args[0],1,2))+add_
green_	= @em.hex.in_dec($mid($args[0],3,2))+add_
blue_	= @em.hex.in_dec($mid($args[0],5,2))+add_
$alpha_	= $mid($args[0],7,2)
if red_>255: red_=255
if red_<0: red_=0
if green_>255: green_=255
if green_<0: green_=0
if blue_>255: blue_=255
if blue_<0: blue_=0
$result=@em.dec.in_col(red_)+@em.dec.in_col(green_)+@em.dec.in_col(blue_)+$alpha_
--- em.col.add ---------------------------------


# em.col.inv
local $r = '[A-Fa-f0-9]'
if no (strcomp($args[0],$r+'{6}') or strcomp($args[0],$r+'{8}')): exit 
local $red_, $green_, $blue_, r_, g_, b_, $alpha_
r_ = 255 - @em.hex.in_dec($mid($args[0],1,2))
g_ = 255 - @em.hex.in_dec($mid($args[0],3,2))
b_ = 255 - @em.hex.in_dec($mid($args[0],5,2))
$alpha_ = $mid($args[0],7,2)
$red_ = @em.dec.in_col(r_)
$green_ = @em.dec.in_col(g_)
$blue_ = @em.dec.in_col(b_)
$result = $red_ + $green_ + $blue_ + $alpha_
--- em.col.inv ---------------------------------


# em.col.in_rgb
local $r = '[A-Fa-f0-9]'
local rr_, gg_, bb_, aa_
if no (strcomp($args[0], $r+'{6}') or strcomp($args[0], $r+'{8}')): result = 0 & exit 
if len($args[0])=6: $args[0]+='ff'
rr_ = @em.hex.in_dec($mid($args[0],1,2))
gg_ = @em.hex.in_dec($mid($args[0],3,2))
bb_ = @em.hex.in_dec($mid($args[0],5,2))
aa_ = @em.hex.in_dec($mid($args[0],7,2))
result=rgb(rr_, gg_, bb_, aa_)
--- em.col.in_rgb ---------------------------------


# em.dec.in_col
local $minus_, base_16_, num_of_digit_
$result=''
if args[0]<0: args[0]=-args[0] & $minus_='-'
if args[0]>255: args[0]=255
base_16_=1
num_of_digit_=0
loop while no (args[0]/base_16_<16):
	base_16_*=16
	num_of_digit_+=1
end
loop local run=1 while run:
	if num_of_digit_=0:
		$result += $mid('0123456789abcdef',args[0]+1,1)
		run=0
	else:
		$result += $mid('0123456789abcdef',args[0]/base_16_+1,1)
		args[0]=args[0] mod base_16_	
		num_of_digit_-=1
			base_16_ = 1
			loop local i=num_of_digit_ while i>0 step i-=1:	base_16_ *= 16
	end
end
if len($result)=1:
	$result = '0' + $result
elseif no $result:
	$result = '00'
end
$result = $minus_+$result
--- em.dec.in_col ---------------------------------


# em.dec.in_hex
local $minus_, base_16_, num_of_digit_
$result=''
if args[0]<0: args[0]=-args[0] & $minus_='-'
base_16_=1
num_of_digit_=0
loop while no (args[0]/base_16_<16) step num_of_digit_+=1:
	base_16_*=16
end
loop local run=1 while run:
	if num_of_digit_=0:
		$result+=$mid('0123456789abcdef',args[0]+1,1)
		run=0
	else
		$result+=$mid('0123456789abcdef',args[0]/base_16_+1,1)
		args[0]=args[0] mod base_16_	
		num_of_digit_-=1
			base_16_=1
			loop local i=num_of_digit_ while i>0 step i-=1:
				base_16_*=16
			end
	end
end
$result=$minus_+$result
--- em.dec.in_hex ---------------------------------


# em.hex.add
local $first_add_, $second_add_ = $lcase($args[0]), $lcase($args[1])
local max_len_, number_, $value_
number_['0']=0 & $value_[0]='0'
number_['1']=1 & $value_[1]='1'
number_['2']=2 & $value_[2]='2'
number_['3']=3 & $value_[3]='3'
number_['4']=4 & $value_[4]='4'
number_['5']=5 & $value_[5]='5'
number_['6']=6 & $value_[6]='6'
number_['7']=7 & $value_[7]='7'
number_['8']=8 & $value_[8]='8'
number_['9']=9 & $value_[9]='9'
number_['a']=10 & $value_[10]='a'
number_['b']=11 & $value_[11]='b'
number_['c']=12 & $value_[12]='c'
number_['d']=13 & $value_[13]='d'
number_['e']=14 & $value_[14]='e'
number_['f']=15 & $value_[15]='f'
max_len_ = iif(len($first_add_)>len($second_add_), len($first_add_), len($second_add_))
local $em_zero_ = {	loop while args[0]>0 step args[0]-=1: $result+='0' }
$first_add_ = $dyneval($em_zero_, max_len_-len($first_add_)) + $first_add_
$second_add_ = $dyneval($em_zero_ ,max_len_-len($second_add_)) + $second_add_
loop local last_byte_, run_ = 0, 1 while run_:
	$result=''
	last_byte_=0
	loop local i,res_byte_=max_len_,0 while i>0 step i-=1:
		res_byte_=number_[$mid($first_add_,i,1)]+number_[$mid($second_add_,i,1)]+last_byte_
		last_byte_=res_byte_/16
		res_byte_=res_byte_ mod 16
		$result=$value_[res_byte_]+$result
	end
	if last_byte_>0:
		$result=$value_[last_byte_]+$result	
	end
	run_=0	
end
--- em.hex.add ---------------------------------


# em.hex.in_dec
$args[0] = $lcase($args[0])
local $last_symbol_
result = 0
loop local i, t, len_ = 0, 0, len($args[0]) while i < len_ step i += 1:
	$last_symbol_ = $mid($args[0], len($args[0])-i, 1)
	t = instr('0123456789abcdef', $last_symbol_) - 1 
	loop local j = i while j > 0 step j -= 1: t *= 16
	result += t	
end
--- em.hex.in_dec ---------------------------------


# em.arr.desort
if $args[0] = '': msg 'em.arr.desort: Wrong array name → <<$args[0]>>' & exit
if $args[1] <> '' and instr('$%', $mid($args[1], 1, 1)): msg 'em.arr.desort: type prefix cannot be specified → <<$args[1]>>' & exit
if $args[2] = '': $args[2] = $args[0]
$args[21] = iif(instr('$%', $mid($args[0],1,1)), $mid($args[0],1,1), '')
local %em_arr_desort_reflect_array_
@@em.arr.concatenate '%em_arr_desort_reflect_array_', $args[1], $args[0]
sortarr '%em_arr_desort_reflect_array_', 0
loop args[22], args[23] = 0, arrsize('%em_arr_desort_reflect_array_') while args[22] < args[23] step args[22] += 1:
	if $args[21] = '%':
		args[24], %em_arr_desort_reflect_array_[args[22]] = %em_arr_desort_reflect_array_[args[22]]
	elseif $args[21] = '$':
		args[24], $em_arr_desort_reflect_array_[args[22]] = %em_arr_desort_reflect_array_[args[22]]
	else:
		args[24], em_arr_desort_reflect_array_[args[22]] = %em_arr_desort_reflect_array_[args[22]]
	end
end
copyarr $args[2], 'em_arr_desort_reflect_array_'
--- em.arr.deSort ---------------------------------


# em.arr.simpl
local em_arr_simp_copy_array_0_, em_arr_simp_copy_array_1_
copyarr 'em_arr_simp_copy_array_0_', $args[0]
copyarr 'em_arr_simp_copy_array_1_', $args[1]
local $type_
if instr($args[0],'%')<>0 or instr($args[1],'%')<>0:
	$type_ = '%'
elseif instr($args[0],'$')<>0 or instr($args[1],'$')<>0:
	$type_ = '$'
end
local $array_name_0_, $array_name_1_= $type_+'em_arr_simp_copy_array_0_', $type_+'em_arr_simp_copy_array_1_'
local $cmd_ = $lcase($args[2])
if instr($cmd_,'[space exclude]') <> 0: $cmd_ = $replace($cmd_,'[space exclude]','[se]')
if instr($cmd_,'[simp]') <> 0 or instr($cmd_,'[se]') <> 0:
	sortarr $array_name_0_, 1	
	sortarr $array_name_1_, 1	
	if instr($cmd_, '[se]') <> 0:
		@@em.arr.clear $array_name_0_
		@@em.arr.clear $array_name_1_
	end
end
if arrsize($array_name_0_) <> arrsize($array_name_1_) and no instr($cmd_,'[conc]'):
	result = 0 & exit
elseif (arrsize($array_name_0_)=0 or arrsize($array_name_1_)=0) and arrsize($array_name_0_) <> arrsize($array_name_1_):
	result = 0 & exit
elseif arrsize($array_name_0_) > arrsize($array_name_1_) and instr($cmd_,'[conc]') <> 0:
	$array_name_0_, $array_name_1_ = $array_name_1_, $array_name_0_
end
loop local i = arrsize($array_name_0_)-1 while i > -1 step i -= 1:
	if instr($cmd_, '[conc]') <> 0:
		result = iif(arrpos($array_name_1_, arritem($array_name_0_, i)) <> -1, 1, 0)
		if result: exit
	else
		result = iif(arritem($array_name_0_, i) = arritem($array_name_1_, i), 1, 0)
		if no result: exit
	end
end
--- em.arr.simpl ---------------------------------


# em.arr.sort
if $args[0] = '': msg 'em.arr.sort: Wrong array name → <<$args[0]>>' & exit
if $args[2]<>'' and instr('$%', $mid($args[2],1,1)): msg 'em.arr.sort: type prefix cannot be specified → <<$args[2]>>' & exit
if $args[3] = '': $args[3] = $args[0]
$args[21] = iif(instr('$%', $mid($args[0],1,1)), $mid($args[0],1,1), '')
local %em_arr_sort_enum_array_ 
local em_arr_sort_refl_array_ 
local em_arr_sort_result_array_ 
copyarr '<<$args[21]>>em_arr_sort_result_array_', $args[0]
@@em.arr.enumerate '<<$args[21]>>em_arr_sort_result_array_', '%em_arr_sort_enum_array_'
sortarr '%em_arr_sort_enum_array_', args[1]
loop args[22] = 0 while args[22]<arrsize('%em_arr_sort_enum_array_') step args[22]+=1:
	if $args[21] = '%':
		%em_arr_sort_result_array_[args[22]], em_arr_sort_refl_array_[args[22]] = %em_arr_sort_enum_array_[args[22]]
	elseif $args[21] = '$':
		$em_arr_sort_result_array_[args[22]], em_arr_sort_refl_array_[args[22]] = %em_arr_sort_enum_array_[args[22]]
	else:
		em_arr_sort_result_array_[args[22]], em_arr_sort_refl_array_[args[22]] = %em_arr_sort_enum_array_[args[22]]
	end
end
if $args[2] <> '': copyarr $args[2], 'em_arr_sort_refl_array_'
copyarr $args[3], '<<$args[22]>>em_arr_sort_result_array_'
--- em.arr.sort ---------------------------------


# em.arr.print
args[21], args[22] = %iif(%args[2] = [] and arrsize($args[0])<>0, [0, arrsize($args[0])-1], %args[2])
$result = ''
if (args[22] < 0 or args[21] < 0): exit
if $args[0]='': msg 'em.arr.print: No array name → <<$args[0]>>' & exit
if args[22] < args[21] or args[21] < 0: msg 'em.arr.print: Out of range → <<[args[21], args[22]]>>' & exit
$args[1] = $lcase($args[1])
if $args[3] = '': $args[3] = @em.RN	
if $args[3] = '/se': $args[3] = ''
$args[23] = $iif(instr('$%', $mid($args[0], 1, 1)),  $mid($args[0], 1, 1), '')
args[24] = iif(instr($args[1], '[only result]'), 1, 0)
loop args[26], args[27] = args[21], args[22]+1 while args[26]<args[27] step args[26]+=1:
	if no args[24]: $result += $args[0] + "[<<args[26]+args[21]>>] = "
	if $args[23] = '$':
		$args[25] = arritem($args[0], args[26])
		if instr($args[1], '[trim]'): $args[25] = $trim($args[25])
		if no args[24]:
			$args[25] = $replace($args[25], "'", "''")
			$result += "'<<$args[25]>>'"
		else:
			$result += $args[25]
		end
	else:
		$result += $str(arritem($args[0], args[26]))
	end
	if instr($args[1], '[with last]') or args[26] <> args[27]-1:
		$result += $args[3]
	end
end
--- em.arr.print ---------------------------------


# em.fewArrs.print
args[21]=arrsize('$args')-1	
args[24] = arrcomp('$args','[\s\S]*((\b\d+([A-Za-zа-яА-Я\$\%\._]+\d*)+\b)|(\b[A-Za-zа-яА-Я\$\%\._]+[^A-Za-zа-яА-Я\$\%\._]+))[\s\S]*')
args[22] = iif($strfind($args[args[21]],'\[.+?\]')<>'', 1, 0)
$args[23] = 'Error: All your massives are empty.'
if args[24]<>-1 and args[24]<>args[21]:
	msg "em.fewArrs.print: Array's name is not correct. ARGS[<<args[24]>>]: '<<$args[args[24]]>>'"
	exit
end
args[25], args[26] = 0, -1
if args[22]:
	$args[30]=$lcase($args[args[21]])
	args[27] = iif(instr($args[30],'[no table]'), 0, 1)
	if instr($args[30],'[only result]'): args[27], args[28] = 0, 1
	if instr($args[30], '[range onscreen:'):
		args[25] = val($strfind($args[30], '\[range onscreen:(\d+)\-\d+\]', 1))
		args[26] = val($strfind($args[30], '\[range onscreen:\d+\-(\d+)\]', 1)) + 1
	end
	if instr($args[30], '[empty:'):
		$args[23] = $strfind($args[args[21]], '(\[empty:)(.+?)\]', 2)
	end
	args[21] -= 1
else:
	args[27] = 1
	args[28] = 0
end
if args[27] or no args[22]: $args[29]='<table border=1 cellpadding=5>'
if args[27]: $args[29] += '<tr><td>#</td>'
loop args[31]=0 while args[31]<args[21]+1 and $strfind($args[args[31]],'\[.+?\]')='' and $args[args[31]]<>'' step args[31]+=1:
	if args[27]: $args[29] += "<td><<$args[args[31]]>></td>"
	args[34]=arrsize($args[args[31]])
	if args[34]>args[35]: args[35]=args[34]
end
if args[27]: $args[29] += '</tr>'
if args[35]=0:
	$result = $args[23]
	exit
end
if args[25] > args[35] - 1:
	args[25] = args[35] - 1
end
if args[26] > args[35] or args[26] = -1:
	args[26] = args[35]
elseif args[26] <= args[25]:
	args[26] = args[25] + 1
end
loop args[32]=args[25] while args[32]<args[26] step args[32]+=1:
	if args[27]: $args[29] += "<tr><td><<args[32]>></td>"
	loop args[31]=0 while args[31]<args[21]+1 and $strfind($args[args[31]],'\[.+?\]')='' and $args[args[31]]<>'' step args[31]+=1:
		if no args[28] and no args[27]:
			$args[33]=$args[args[31]]+"[<<args[32]>>]="
		else
			$args[33]=''
		end
		if instr($args[args[31]],'%')=1:
			$args[33] += @em.html.to_mnemonics($str(%arritem($args[args[31]],args[32])))
		elseif instr($args[args[31]],'$')=1:
			if args[27]:
				$args[33]+=$dyneval({
					!@ $1 - название массива
					!@ $0 - номер ячейки
					if $arritem($args[1],args[0])<>'':
						$result = @em.html.to_mnemonics($arritem($args[1],args[0]))
					else
						!@ в пустых ячейках ставим пробелы
						$result = '&nbsp;'
					end
				},args[32],$args[args[31]])
			else
				if no args[28]:
					$args[33]+="'"+$replace($arritem($args[args[31]],args[32]),"'","''")+"'"
				else
					$args[33] += $arritem($args[args[31]],args[32])
				end
			end
		else:
			$args[33]+=$str(arritem($args[args[31]], args[32]))
		end
		if args[27]:
			$args[29] += '<td>'+$args[33]+'</td>'
		elseif args[28] and args[31]<>0:
			$args[36]+='	'+$args[33]
		elseif args[31]<>0:
			$args[36]+='	&	'+$args[33]
		else:
			$args[36]+=$args[33]
		end
	end
	if args[27]:
		$args[29] += "</tr>"
	elseif args[32]+1<args[26]:
		$args[36]+=@em.RN	
	end
end
if args[27]: $args[29] += '</table>'
if args[27]:
	$result = $args[29]
elseif $args[36]<>'':
	$result = $args[36]
else
	msg 'em.fewArrs.print: If you see this message, that so wrong. Save the game and ask me on aleksversus@mail.ru. Error of easy.math.libs in em.fewArrs.print'
end
--- em.fewArrs.print ---------------------------------


# em.arr.clear
if 0:
	elseif instr($args[0],'%')=1: $args[22] = '%'
	elseif instr($args[0],'$')=1: $args[22] = '$'
	else: $args[22] = ''
end
pl '('+arritem('<<$args[22]>>args', 1)+')'
loop args[21] = 0 while 1:
	args[21] = arrpos($args[0], arritem('<<$args[22]>>args', 1), args[21])
	if args[21] = -1 or arrsize($args[0]) = 0: jump 'break'
	killvar $args[0], args[21]
end
:break
--- em.arr.clear ---------------------------------


# em.arr.concatenate
if $args[0] = '': msg 'em.arr.concatenate: Wrong array name → <<$args[0]>>' & exit
if instr($args[0], '%') <> 1: msg 'em.arr.concatenate: type prefix ''%'' not specified → <<$args[0]>>' & exit
args[21], args[23] = arrsize('args'), 0
loop args[22] = 1 while args[22] < args[21] step args[22] += 1:
	args[23] = iif(arrsize($args[args[22]]) > args[23], arrsize($args[args[22]]), args[23])
end
