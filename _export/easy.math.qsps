# em.start
	@@em.usercom.on
	usehtml = 0
	$fname = "Consolas"
	showobjs 0
	showstat 0
	showacts 0
"Easy Math v.<<@em.version('str')>>"
"Библиотека математических и вспомогательных функций для QSP"
"
Для плееров QSP с версией интерпретатора 5.9.5 и выше. Ваша версия: <<$qspver>>.

Репозиторий с исходниками библиотеки:

* https://github.com/AleksVersus/easy.math.3

По всем вопросам и предложениям обращаться:

* aleksversus@mail.ru
* https://vk.com/id40090736

Заходите на мой сайт:

* aleksversus.narod.ru

Поддержите проект, подписавшись на мой бусти:

* https://boosty.to/aleksversus

Обучающие видео по программированию на QSP:

* https://www.youtube.com/channel/UCwX8RW2B9yTUFdlivtCGAgA

Любую функцию можно опробовать прямо здесь, введя её в поле ввода.

Для получения списка команд, введите `em help` в строку ввода."
--- em.start ---------------------------------





# em.version
%result = [3,2,0]
if $args[0] = 'str':
	local y, m, d = %result
	$result = "<<y>>.<<m>>.<<d>>"
end
--- em.version ---------------------------------


# em.usercom
if instr($user_text, 'em ') <> 1: exit
local $user_text_ = $mid($user_text, 4)
local $em_test_parse_
local $cmdline_ = $lcase($trim($user_text_))
	scanstr '$em_test_parse_', $cmdline_, '[^\s]+'
if $cmdline_ = 'help':
	*pl & *pl 'ОСНОВНЫЕ КОМАНДЫ:'
	*pl & *pl "* sqrt(N) — выводит результат вычисления квадратного корня из числа N."
	*pl & *pl "* gen id — генерирует уникальный идентификатор типа UUID четвёртой версии."
	*pl & *pl "* gen pass — генерирует парольную фразу из шестнадцати случайных символов (буквы латинского алфавита, цифры, !@#$)."
	*pl & *pl "* gen mass <ARRAY_NAME> <NUMBER_of_ELEMENTS> — генерирует массив с именем <ARRAY_NAME> из <NUMBER_of_ELEMENTS> элементов."
	*pl & *pl "* autotest — запускает на выполнение автотесты библиотеки для проверки её работоспособности. Внимание!!! Автотесты нужны для отладки самой библиотеки, или для проверки корректности её функций перед окончательной сборкой. Из окончательной сборки автотесты можно удалить."
	*pl "Для теста отдельной функции, можно указать её название как аргумент команде autotest. Например: `autotest em.str.thin`."
	*pl & *pl "Любая иная строчка будет воспринята, как код QSP на выполнение. Таким образом вы можете выполнить любую строчку кода QSP, просто введя её в строке ввода."
elseif $cmdline_='logs':
	if loc('em.arr.print'):
		*pl @em.arr.print('$log','[only result]')
	else:
		msg "Error. Function 'em.arr.print' is not exist! Print log by cycle:"
		loop local i=0 while i<arrsize('$log') step i+=1:
			*pl $log[i]
		end
	end
elseif instr($cmdline_,'sqrt')=1:
	if loc('em.sqrt'):
		killvar '$em_test_parse_'
		$em_test_parse_[0]=$mid($cmdline_,instr($cmdline_,'(')+1,instr($cmdline_,')')-instr($cmdline_,'(')-1)
		$em_test_parse_[0]= $dyneval("$result=$str(<<$em_test_parse_[0]>>)")
		*pl @em.sqrt($em_test_parse_[0])
	else:
		msg "Error. Function 'em.sqrt' is not exist!"
	end
elseif $cmdline_='gen id':
	if loc('em.gen_uuid'):
		*pl @em.gen_uuid()
	else:
		msg "Error. Function 'em.gen_uuid' is not exist!"
	end
elseif $cmdline_='gen pass':
	if loc('em.str.random'):
		*pl @em.str.random(16,'[inc][\z][\d]','!@#$')
	else:
		msg "Error. Function 'em.str.random' is not exist!"
	end
elseif instr($trim($lcase($cmdline_)),'gen mass')=1:
	if loc('em.arr.fill_rand') and loc('em.arr.print'):
		local count
		if $em_test_parse_[2]<>'':
			if $em_test_parse_[3]<>'' and isnum($em_test_parse_[3]): count=val($em_test_parse_[3]) else count=10
			@@em.arr.fill_rand $em_test_parse_[2],count
			@em.arr.print($em_test_parse_[2])
		else
			*pl "Error input. Type:"
			*pl "gen mass <ARRAY_NAME> <NUMBER_of_ELEMENTS>"
		end
	else:
		msg "Error. Functions 'em.arr.fill_rand' or 'em.arr.print' are not exist!"
	end
elseif instr($cmdline_,'autotest') = 1 and loc('em.autotest.self'):
	@@em.autotest.self $em_test_parse_[1], $em_test_parse_[2]
else:
	dynamic $cmdline_
end
--- em.usercom ---------------------------------
# em.usercom.on
$usercom['em.usercom'] = 'em.usercom'
-- em.usercom.on ---------------------------------
# em.usercom.off
killvar '$usercom', 'em.usercom'
-- em.usercom.off ---------------------------------


# em.autotest
$args[0]=$lcase($args[0])
local $nr=@em.RN
$result = ''
if $args[0]='em.fewarrs.print':
	$result=$dyneval({
		local $a, %b, $c, %d
		$result = ''
		$a[]='нулевая ячейка'
		$a[]='первая ячейка'
		$a[]='вторая ячейка'
		$a[]=''
		$a[]='четвёртая'' ячейка'
		$a[]="пятая яче'йка"
		$a[]=''
		$a[]='седьмая ячейка'

		%b[]= [0, 'zero']
		%b[]= ['first', 1, 0]
		%b[]= [2, 'second', 2]
		%b[]= ['3']
		%b[]=(3,5,6,'string',6)
		%b[]='пятая ячейка'
		%b[]='6'
		%b[]='7'
		$result += @em.fewArrs.print('$a','%b')
		$result += @em.fewArrs.print('$a','%b', '[range onscreen:3-6]')
		$result += @em.fewArrs.print('$a','%b','[only result]')
		$result += @em.fewArrs.print('$a','%b','[no table]')
		$result += @em.fewArrs.print('$c','%d', '[empty:EMPTY ARRAYS]')
	})
elseif $args[0]='em.simpl':
	$result=dyneval ({
		$result = ''
		$result+=@em.simpl('9.05',"-9")+$nr		& !@ '9.05'
		$result+=@em.simpl('9.05','-9.05')+$nr	& !@ '9.05'
		$result+=@em.simpl('9.05',"10")+$nr		& !@ '10'
		$result+=@em.simpl('9.05',"9.55")+$nr	& !@ '9.55'
		$result+=@em.simpl('9.99',"9.999")+$nr	& !@ '9.999'
		$result+=@em.simpl('-1.69',"1.3")+$nr	& !@ '1.3'
		$result+=@em.simpl('-1.69',"-1.3")+$nr	& !@ '-1.3'
		$result+=@em.simpl('1.69',"1.3")+$nr	& !@ '1.69'
		$result+=@em.simpl('1.69',"-1.3")+$nr	& !@ '1.69'
	})
elseif $args[0]='em.round':
	$result=$dyneval ({
		$result = ''
		$result+=@em.round("945.459","0.1")+$nr  			& !@ '945.5'
		$result+=@em.round("945.459","0.1",'[down]')+$nr	& !@ '945.4'
		$result+=@em.round("945.444","0.1",'[up]')+$nr		& !@ '945.5'
		$result+=@em.round("945.459","0.01")+$nr  			& !@ '945.46'
		$result+=@em.round("945.459","0.001")+$nr			& !@ '945.459'
		$result+=@em.round("945.459","1")+$nr    			& !@ '945'
		$result+=@em.round("945.459","10")+$nr   			& !@ '950'
		$result+=@em.round("945.459","100")+$nr  			& !@ '900'
		$result+=@em.round("-945.459","10")+$nr  			& !@ '-950'
		$result+=@em.round("-945.459","0.01")+$nr			& !@ '-945.46'
	})
elseif $args[0]='em.mult':
	$result=$dyneval ({
		$result = ''
		$result+=@em.mult("38.4","2.5")+$nr									& !@ '96'
		$result+=@em.mult('9.05',"-9.05")+$nr								& !@ '-81.9025'
		$result+=@em.mult('9.05',"10")+$nr									& !@ '90.5'
		$result+=@em.mult('9.05',"9.55","9.25")+$nr							& !@ '799.454375'
		$result+=@em.mult('9.99',"-9.999","9.9")+$nr						& !@ '-988.911099'
		$result+=@em.mult('2','2','2','2','2','2','2','2','2')+$nr			& !@ '512'
		$result+=@em.mult('-2','-2','-2','-2','-2','-2','-2','-2','-2')+$nr	& !@ '-512'
	})
elseif $args[0]='em.div':
	$result=$dyneval ({
		$result = ''
		$result+=@em.div('9.05',"-9",10000)+$nr		& !@ '-1.0055'
		$result+=@em.div('9.05','-9.05',10000)+$nr	& !@ '-1'
		$result+=@em.div('9.05',"10")+$nr			& !@ '0.905'
		$result+=@em.div('9.05',"9.55",10000)+$nr	& !@ '0.9476'
		$result+=@em.div('9.99',"9.999",10000)+$nr	& !@ '0.999'
		$result+=@em.div('9.99',"9.999",1000000)+$nr	& !@ '0.999099'
		$result+=@em.div('-1.69',"1.3",10000)+$nr	& !@ '-1.3'
		$result+=@em.div('1.69',"1.3",10000)+$nr		& !@ '1.3'
		$result+=@em.div('-1.69',"-1.3",10000)+$nr	& !@ '1.3'
		$result+=@em.div('1.69',"-1.3",10000)+$nr	& !@ '-1.3'
	})
elseif $args[0]='em.add':
	$result=$dyneval({
		$result = ''
		$result+=@em.add('9.05','-9')+$nr							& !@ '0.05'
		$result+=@em.add('9.05','-9.05')+$nr						& !@ '0'
		$result+=@em.add('9.05','9')+$nr							& !@ '18.05'
		$result+=@em.add('9.05','9.55','9.25')+$nr					& !@ '27.85'
		$result+=@em.add('9.99','9.999','9.9')+$nr					& !@ '29.889'
		$result+=@em.add('384.384','92.8',3)+$nr					& !@ '480.184'
		$result+=@em.add('283','126')+$nr							& !@ '409'
		$result+=@em.add('283','-126')+$nr							& !@ '157'
		$result+=@em.add('-283','126')+$nr							& !@ '-157'
		$result+=@em.add('-283','-126')+$nr							& !@ '-409'
		$result+=@em.add('-234','125','-13.7890303','3484889')+$nr	& !@ '3484766.2109697'
	})
elseif $args[0]='em.sqrt':
	$result=$dyneval({
		$result = ''
		$result+=@em.sqrt('1000',10000)+$nr	& !@ 31.6227
		$result+=@em.sqrt('16',10000)+$nr	& !@ 4
		$result+=@em.sqrt('257',100000)+$nr	& !@ 16.03121
		$result+=@em.sqrt('257',10000)+$nr	& !@ 16.0312
		$result+=@em.sqrt('257',1000)+$nr	& !@ 16.031
		$result+=@em.sqrt('257',100)+$nr	& !@ 16.03
		$result+=@em.sqrt('2.1',100)+$nr	& !@ 1.44
		$result+=@em.sqrt('259',100)+$nr	& !@ 16.09
		$result+=@em.sqrt('260',100)+$nr	& !@ 16.12
		$result+=@em.sqrt('1.69',100)+$nr	& !@ 1.3
		$result+=@em.sqrt('0.69',10000)+$nr	& !@ 0.8306
	})
elseif $args[0]='em.byte.add':
	$result=$dyneval({
		$result = ''
		$result+=@em.byte.add(998765,273)	& !@ '999038'
		$result+=@em.byte.add('9987Y5','-273')	& !@ '998978'
		$result+=@em.byte.add('999999','6273')	& !@ '006273'
		$result+=@em.byte.add('998705','5773')	& !@ '004479'
	})
elseif $args[0]='em.byte.dev':
	$result=$dyneval({
		$result = ''
		$result+=@em.byte.dev(998765,273)	& !@ '998492'
		$result+=@em.byte.dev('9987Y5','-273')	& !@ '998432'
		$result+=@em.byte.dev('999999','6273')	& !@ '993726'
		$result+=@em.byte.dev('998705','5773')	& !@ '992932'
	})
elseif $args[0]='em.arr.print':
	$result=$dyneval({
		$result = ''
		local $a
		$a[]='нулевая ячейка'
		$a[]='   первая ячейка   '
		$a[]=' вторая ячейка'
		$a[]=''
		$a[]=(1,2,3,5,6)
		$a[]='   пятая ячейка'
		$a[]=''
		$a[]='седьмая ячейка'

		$result+=@em.arr.print('$a')+$nr
		$result+=@em.arr.print('$a','[only result]')+$nr
		$result+=@em.arr.print('$a','[trim]')+$nr
		$result+=@em.arr.print('$a','[trim] [only result]',[2,5],'|')+$nr
		$result+=@em.arr.print('$a','[trim] [only result] [with last]',[2,5],'|')+$nr
	})
elseif $args[0]='em.arr.insert':
	$result=$dyneval({
		$result = ''
		local mass
		mass[0]=574
		mass[1]=668
		mass[2]=413
		mass[3]=765
		mass[4]=478
		mass[5]=205
		mass[6]=701
		mass[7]=272

		@@em.arr.insert 'mass',6,4
		$result+=@em.arr.print('mass')
	})
elseif $args[0]='em.arr.clear':
	$result=$dyneval({
		$result = ''
		local i
		i[0]=1
		i[1]=2
		i[2]=3
		i[3]=1
		i[4]=2
		i[5]=3
		i[6]=1
		i[7]=2

		@@em.arr.clear 'i', 2
		$result=@em.arr.print('i')
	})
elseif $args[0]='em.arr.desort':
	$result = $dyneval({
		$result = ''
		local old_mass, em_array, new_mass
		old_mass[0]=949
		old_mass[1]=913
		old_mass[2]=269
		old_mass[3]=901
		old_mass[4]=257
		old_mass[5]=561
		old_mass[6]=529
		old_mass[7]=293
		!@ сортируем массив
		@@em.arr.sort 'old_mass',0,'em_array'
		$result+=@em.arr.print('old_mass')+@em.RN
		$result+=@em.arr.print('em_array')+@em.RN
		!@ восстанавливаем исходный массив в новом массиве
		@@em.arr.deSort 'old_mass','em_array','new_mass'
		$result+=@em.arr.print('new_mass')
	})
elseif $args[0]='em.arr.sort':
	$result=$dyneval({
		$result = ''
		old_mass[0]=157
		old_mass[1]=250
		old_mass[2]=709
		old_mass[3]=413
		old_mass[4]=532
		old_mass[5]=779
		old_mass[6]=730
		old_mass[7]=565

		@@em.arr.sort('old_mass')
		$result+=@em.arr.print('old_mass')+@em.RN

		old_mass[0]=966
		old_mass[1]=812
		old_mass[2]=796
		old_mass[3]=304
		old_mass[4]=678
		old_mass[5]=118
		old_mass[6]=901
		old_mass[7]=132

		@@em.arr.sort('old_mass',0,'em_array')
		$result+=@em.arr.print('old_mass')+@em.RN
		$result+=@em.arr.print('em_array')+@em.RN

		%old_mass[0]=[967, 'голова']
		%old_mass[1]=[629, 'плечи']
		%old_mass[2]=[541, 'руки']
		%old_mass[3]=[290, 'торс']
		%old_mass[4]=[852, 'бёдра']
		%old_mass[5]=[334, 'голени']
		%old_mass[6]=[318, 'ступни']
		%old_mass[7]=[529, 'нишваа']

		@@em.arr.sort('%old_mass',0,'em_array','%new_mass')

		$result+=@em.arr.print('%old_mass')+@em.RN
		$result+=@em.arr.print('em_array')+@em.RN
		$result+=@em.arr.print('%new_mass')+@em.RN

		$mass[0]='88ff88'
		$mass[1]='ff00ff'
		$mass[2]='0ff0f8'
		$mass[3]='ffffff'
		$mass[4]='8888ff'
		$mass[5]='fff8f8'

		@@em.arr.sort('$mass',1,'em_array')
		$result+=@em.arr.print('$mass')+@em.RN
		$result+=@em.arr.print('em_array')
	})
elseif $args[0]='em.arr.restand':
	$result = $dyneval({
		$result = ''
		$arr_mass[0]='голова'
		$arr_mass[1]='плечи'
		$arr_mass[2]='грудь'
		$arr_mass[3]='живот'
		$arr_mass[4]='бёдра'
		$arr_mass[5]='колени'
		$arr_mass[6]='икры'
		$arr_mass[7]='ступни'

		old_mass[0]=722
		old_mass[1]=136
		old_mass[2]=788
		old_mass[3]=177
		old_mass[4]=780
		old_mass[5]=97
		old_mass[6]=649
		old_mass[7]=75

		@@em.arr.sort 'old_mass',0,'em_array'
		@@em.arr.restand '$arr_mass','em_array','$new_mass'

		$result+=@em.arr.print('old_mass')+@em.RN
		$result+=@em.arr.print('em_array')+@em.RN
		$result+=@em.arr.print('$new_mass')
	})
elseif $args[0]='em.arr.simpl':
	$result=$dyneval({
		$result = ''
		local mass1, mass2, mass3
		mass1[0]=455
		mass1[1]=705
		mass1[2]=967
		mass1[3]=452
		mass1[4]=829
		mass1[5]=84
		mass1[6]=983
		mass1[7]=824

		mass2[0]=455
		mass2[1]=705
		mass2[2]=967
		mass2[3]=452
		mass2[4]=829
		mass2[5]=84
		mass2[6]=983
		mass2[7]=824

		mass3[0]=983
		mass3[1]=967
		mass3[2]=829
		mass3[3]=824
		mass3[4]=705
		mass3[5]=455
		mass3[6]=452
		mass3[7]=84

		$result+=$str(@em.arr.simpl('mass1','mass2'))
		$result+=$str(@em.arr.simpl('mass1','mass3'))
		$result+=$str(@em.arr.simpl('mass1','mass3','[simp]'))
	})
elseif $args[0]='em.zero':
	$result=$dyneval({
		$result = ''
		$result+=@em.zero(13)+$nr	& !@ '0000000000000'
		$result+=@em.zero(13,'1')+$nr	& !@ '1111111111111'
		$result+=@em.zero(13,'10')+$nr	& !@ '10101010101010101010101010'
		$result+=@em.zero(13,'a')+$nr	& !@ 'aaaaaaaaaaaaa'
		$result+=@em.zero(3,'bla')+$nr	& !@ 'blablabla'
	})
elseif $args[0]='em.str.thin':
	$result=$dyneval({
		$result = ''
		$result+=@em.str.thin('профессура')+$nr
		$result+=@em.str.thin('профессура',1,'|')+$nr
		$result+=@em.str.thin('профессура',1,'|','[right]')+$nr
		$result+=@em.str.thin('профессура',1,'|','[left]')+$nr
		$result+=@em.str.thin('профессура',1,'|','[right][left]')+$nr
		$result+=@em.str.thin('профессура',3,'|')+$nr
		$result+=@em.str.thin('профессура',3,'|','[up]')+$nr
		$result+=@em.str.thin('профессура',3,'|','[left]')+$nr
		$result+=@em.str.thin('профессура',2,'|','[right]')+$nr
		$result+=@em.str.thin('профессура',1,'||','[left] [right]')+$nr
	})
elseif $args[0]='em.hex.add':
	$result=$dyneval({
		$result = ''
		$result+=@em.hex.add('ffeeff','a1')+$nr
		$result+=@em.hex.add('f0','f')+$nr
		$result+=@em.hex.add('ff','1')+$nr
		$result+=@em.hex.add('ffe','1')+$nr
		$result+=@em.hex.add('fef','1')+$nr
		$result+=@em.hex.add('aaaaaa','cc')+$nr
	})
elseif $args[0]='em.tag.get_num':
	$result = $dyneval({
		$result = ''
		local $text="[count:текст с пробелом] <cord:68> log:непробельные_символы color=#ff8899 tag='многа букав'"
		$result += '[' + @em.tag.get_num($text,'count')+ ']'   & !@ "текст с пробелом"
		$result += '[' + @em.tag.get_num($text,'cord')+ ']'     & !@ '68'
		$result += '[' + @em.tag.get_num($text,'log')+ ']'  & !@ "непробельные_символы"
		$result += '[' + @em.tag.get_num($text,'color')+ ']'    & !@ "ff8899"
		$result += '[' + @em.tag.get_num($text,'tag')+ ']'  & !@ "многа букав"
		$result += '[' + @em.tag.get_num($text,'tag/h')+ ']'    & !@ не выведет ничего
		$result += '[' + @em.tag.get_num($text,'color/h')+ ']'  & !@ "ff8899"
	})
end
--- em.autotest ---------------------------------


