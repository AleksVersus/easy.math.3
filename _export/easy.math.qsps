# em.arr.few_kill
args[21] = arrsize('args')
loop args[22] = args[21] while args[22] > 0 step args[22] -= 1:
	$args[23] = $arrtype('args', args[22]-1)
	if $args[23] = '%':
		killvar $args[0], %args[args[22]-1]
	elseif $args[23] = '$':
		killvar $args[0], $args[args[22]-1]
