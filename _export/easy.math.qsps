# em.digs
if args[0] < 0: args[0] = -args[0]
result = 1
loop while no (args[0]/result < 10): result *= 10
--- em.digs ---------------------------------


# em.even
local module_, at49_, $minus_
if args[1]=0 or strcomp($str(args[1]),'^1[0]+$')=0: args[1]=100
if args[0]<0: args[0]=-args[0] & $minus_='-'
$args[2]=$lcase($args[2])
if instr($args[2],'[up]')=0 and instr($args[2],'[down]')=0:
	module_=args[0] mod args[1]
	at49_=5*args[1]/10-1	
	if module_>at49_: $args[2]='[up]' else $args[2]='[down]'
end
if instr($args[2],'[up]')<>0:
	result = (args[0]/args[1]+1)*args[1]
elseif instr($args[2],'[down]')<>0:
	result = (args[0]/args[1])*args[1]
end
if $minus_='-':
	result = -result
end
--- em.even ---------------------------------


# em.exp
result = 1	
loop while args[1]>0 step args[1] -= 1: result *= args[0]
--- em.exp ---------------------------------


# em.log
if args[1]=0: args[1]=10
result=0
loop local base_ = 1 while no (args[0]/base_ < args[1]):
	base_ *= args[1]
	result += 1
end
--- em.log ---------------------------------


# em.random
local em_random_temp_array_, j, k
loop local i=0 while i < arrsize('args') step i+=1:
	j, k = %args[i]
	loop while j <= k step j += 1:
		if arrpos('em_random_temp_array_', j) = -1: em_random_temp_array_[] = j
	end
end
result = em_random_temp_array_[rand(0, arrsize('em_random_temp_array_')-1)]
--- em.random ---------------------------------


# em.summ
local $_, $res_ = '', ''
if $args[0]='': exit	
if instr($args[0],'$')=1:
	$_='$'
	if $args[1]='':
		$args[1]=' '
	elseif $args[1]='/se':
		$args[1]=''
	end
elseif instr($args[0],'%')=1:
	$_='%'
end
loop local i,size_ =0,arrsize($args[0]) while i<size_  step i+=1:
	if $_='$':
		$res_ += $arritem($args[0], i) + $args[1]
	elseif $_ = '%':
		%res_ = (%res_ & %arritem($args[0], i))
	else:
		res_ += arritem($args[0], i)
	end
end
if $_='$':
	$result = $res_
elseif $_='%':
	%result = %res_
else
	result = res_
end
--- em.summ ---------------------------------


# em.map.cell.get_сoords
local cell, width = args[0], args[1]
local x, y
y = cell/width
x = cell - y*width
%result = [x, y]
--- em.map.cell.get_сoords ---------------------------------


# em.html.clr_pref
local $prevtag_, $aftertag_
loop while 1:
    $prevtag_ = $strfind($args[0],'[\s\r\n]+<')
    $aftertag_ = $strfind($args[0],'>[\s\r\n]+')
    if $prevtag_ <> '':
        $args[0] = $replace($args[0], $prevtag_, '<')
    elseif $aftertag_ <> '':
        $args[0] = $replace($args[0], $aftertag_, '>')
    else
        jump 'out'
    end
end
:out
$result = $trim($args[0])
--- em.html.clr_pref ---------------------------------


# em.html.to_mnemonics
$result = $replace($args[0], '&', '&amp;')
$result = $replace($result, '<', '&lt;')
$result = $replace($result,'>', '&gt;')
